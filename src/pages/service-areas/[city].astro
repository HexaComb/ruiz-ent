---
import Layout from '../../layouts/Layout.astro';
import Section from '../../components/Section.astro';
import { serviceAreas, serviceAreaPath, type ServiceArea } from '../../data/service-areas';
import { organizationId, siteUrl } from '../../lib/seo';

export function getStaticPaths() {
  return serviceAreas.map(area => ({ params: { city: area.slug }, props: { area } }));
}
interface Props { area: ServiceArea; }
const { area } = Astro.props;
const pageUrl = `${siteUrl}${serviceAreaPath(area.slug)}`;
const structuredData = [
  {
    '@type': 'Service', '@id': `${pageUrl}#service`, name: `Concrete and masonry services in ${area.name}, CA`,
    serviceType: ['General engineering', 'Concrete', 'Masonry'],
    description: area.description, url: pageUrl,
    provider: { '@id': organizationId }, areaServed: { '@type': 'City', name: `${area.name}, California` }
  },
  {
    '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'Service areas', item: `${siteUrl}/service-areas/` },
      { '@type': 'ListItem', position: 3, name: `${area.name}, CA`, item: pageUrl }
    ]
  }
];
---
<Layout title={area.title} description={area.description} structuredData={structuredData}>
  <Section variant="dark" ariaLabelledby="city-heading">
    <div class="stack stack--lg">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol class="cluster cluster--sm">
          <li><a href="/">Home</a><span aria-hidden="true"> / </span></li>
          <li><a href="/service-areas/">Service areas</a><span aria-hidden="true"> / </span></li>
          <li aria-current="page">{area.name}, CA</li>
        </ol>
      </nav>
      <p class="city-eyebrow">Ruiz Family Enterprises · {area.name}, California</p>
      <h1 id="city-heading" class="section-title on-dark">{area.slug === 'kingsburg' ? 'Concrete contractor' : 'Concrete & masonry'}<br />in {area.name}, CA</h1>
      <p class="section-subtitle on-dark">{area.intro}</p>
      <div class="cluster">
        <a href="/#quote-builder" class="btn btn-primary">Request a free on-site estimate</a>
        <a href="tel:+15592441922" class="btn btn-outline-light">Call (559) 244-1922</a>
      </div>
      <p class="city-note">General engineering contractor · Three generations of trade experience</p>
    </div>
  </Section>
  <Section variant="light" ariaLabelledby="city-services-heading">
    <div class="section-header">
      <h2 id="city-services-heading" class="section-title">What can we help you build?</h2>
      <p class="section-subtitle">Discuss these concrete and masonry specialties with our team for your {area.name} property.</p>
    </div>
    <div class="grid-cards">
      <article class="card-surface stack stack--md">
        <h3>Concrete surfaces &amp; finishes</h3>
        <p>Patios, porches, pool decks, driveways, sidewalks and steps, including stamped concrete. Tell us about the layout, finish and any existing surface to remove.</p>
        <a href="/#our-services">Explore concrete services</a>
      </article>
      <article class="card-surface stack stack--md">
        <h3>Walls, stone &amp; brick</h3>
        <p>Block walls, retaining walls, decorative and architectural stone, and brick work. Bring dimensions, site details and reference photos for the masonry you have in mind.</p>
        <a href="/#our-services">Explore masonry services</a>
      </article>
      <article class="card-surface stack stack--md">
        <h3>Engineering &amp; project support</h3>
        <p>General engineering and site improvements, commercial concrete work, drain and gutter work, concrete removal and 3/8-inch concrete pump service. Share your plans so we can discuss the scope.</p>
        <a href="/#engineering-public-works">See engineering &amp; public works</a>
      </article>
    </div>
  </Section>
  <Section variant="white" ariaLabelledby="city-planning-heading">
    <div class="grid-2">
      <div class="stack stack--lg">
        <h2 id="city-planning-heading" class="section-title">{area.planningTitle}</h2>
        <p>{area.planning}</p>
        <h3>Helpful details for your estimate</h3>
        <ul class="planning-list stack stack--md">{area.checklist.map(item => <li>{item}</li>)}</ul>
      </div>
      <aside class="card-surface stack stack--lg" aria-labelledby="city-resource-heading">
        <p class="city-eyebrow">Local planning resource</p>
        <h3 id="city-resource-heading">Before work begins in {area.name}</h3>
        <p>{area.resource.text}</p>
        <a href={area.resource.url}>{area.resource.title} <span aria-hidden="true">↗</span></a>
        <p class="resource-note">This is an independent city resource. Confirm current requirements for your exact property and project with the appropriate department. Nearby unincorporated properties may be handled by the county.</p>
      </aside>
    </div>
  </Section>
  <Section variant="light" container="narrow" ariaLabelledby="city-questions-heading">
    <div class="stack stack--xl">
      <h2 id="city-questions-heading" class="section-title">Planning your {area.name} project</h2>
      {area.questions.map(item => (
        <div class="stack stack--md"><h3>{item.question}</h3><p>{item.answer}</p></div>
      ))}
      <p>To get started, call <a href="tel:+15592441922">(559) 244-1922</a> or <a href="/#quote-builder">request a free on-site estimate</a>. Our family team serves customer properties; this page does not represent a separate office.</p>
    </div>
  </Section>
  <Section variant="dark" density="compact" ariaLabelledby="city-next-heading">
    <div class="stack stack--lg">
      <h2 id="city-next-heading" class="section-title on-dark">Tell us what you have in mind.</h2>
      <p>Share your {area.name} project location, scope and photos or plans. We’ll talk through the work and scheduling.</p>
      <div class="cluster">
        <a href="/#quote-builder" class="btn btn-primary">Discuss your project</a>
        <a href="/#our-work" class="btn btn-outline-light">See our project footage</a>
      </div>
      <nav class="other-areas stack stack--md" aria-label="Other service areas">
        <a href="/service-areas/">All service areas</a>
        <div class="cluster">{serviceAreas.filter(other => other.slug !== area.slug).map(other => <a href={serviceAreaPath(other.slug)}>{other.name}</a>)}</div>
      </nav>
    </div>
  </Section>
</Layout>
<style>
  .breadcrumbs ol { list-style: none; padding: var(--space-0); }
  .breadcrumbs a, .other-areas a { color: inherit; text-decoration: underline; text-underline-offset: var(--space-1); }
  .city-eyebrow { font-weight: 700; }
  .city-note { color: var(--text-light-muted); }
  .planning-list { padding-inline-start: var(--space-6); }
  .resource-note { color: var(--text-dark-muted); }
  .grid-2 { align-items: start; }
  .other-areas { padding-block-start: var(--space-6); border-top: 1px solid var(--border-dark); }
</style>
