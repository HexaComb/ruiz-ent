---
// Ruiz Family Enterprises - Root Layout
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCallButton from '../components/FloatingCallButton.astro';
import { siteUrl, canonicalPath, organizationSchema, serializeSchema } from '../lib/seo';
import '../styles/global.css';
import '../styles/trade-motion.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>[];
}

const {
  noindex = false,
  structuredData = [],
  title = "General Engineering Contractor | Ruiz Family Enterprises | Central Valley",
  description = "Kingsburg-based general engineering contractor serving Fresno, Madera, Visalia, Fowler and Hanford, with concrete and masonry for homes and businesses."
} = Astro.props;

const pagePath = canonicalPath(Astro.url.pathname);
const canonicalUrl = new URL(pagePath, siteUrl).href;
const ogImageUrl = "https://ruizfamilyhardscapes.biz/images/social/ruiz-general-engineering-og.png";
const ogImageAlt = "Ruiz Family Enterprises — General Engineering Contractor serving the Central Valley";

// Only supported organization/service facts; no storefront, ratings or license-status claims.
const schema = { "@context": "https://schema.org", "@graph": [organizationSchema, ...structuredData] };

---

<!doctype html>
<html lang="en" data-analytics-path={noindex ? "/" : pagePath}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-G35MWF4BT4"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      // Keep campaign attribution without sharing arbitrary queries, click IDs,
      // hashes, or missing-page paths. Campaign labels must never contain PII.
      // Build-rendered canonical paths preserve city-page reporting without sending
      // arbitrary request paths, queries or missing-page details.
      const analyticsPath = document.documentElement.dataset.analyticsPath || '/';
      const analyticsLocation = new URL(analyticsPath, 'https://ruizfamilyhardscapes.biz/');
      const campaignQuery = new URLSearchParams(window.location.search);
      for (const key of ['utm_source', 'utm_medium', 'utm_campaign', 'utm_id', 'utm_term', 'utm_content', 'utm_source_platform']) {
        const values = campaignQuery.getAll(key);
        const value = values.length === 1 ? values[0] : '';
        if (/^[a-zA-Z0-9][a-zA-Z0-9 _.-]{0,99}$/.test(value) && !/\d{7,}/.test(value)) {
          analyticsLocation.searchParams.set(key, value);
        }
      }
      gtag('js', new Date());
      gtag('config', 'G-G35MWF4BT4', {
        page_location: analyticsLocation.href,
        page_referrer: '',
        page_title: 'Ruiz Family Enterprises'
      });
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ruiz Family Enterprises Inc" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Preconnect Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- JSON-LD Structured Data -->
    {!noindex && <script type="application/ld+json" set:html={serializeSchema(schema)} />}
  </head>
  <body>
    <!-- Skip to main content for accessibility -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
    <FloatingCallButton />

    <script>
      import { registerClicks } from '../lib/analytics';
      registerClicks();
      const accents = document.querySelectorAll('.section-header, .process-steps-grid');
      const observer = 'IntersectionObserver' in window ? new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('trade-in-view');
          observer?.unobserve(entry.target);
        });
      }, { threshold: 0.2 }) : null;
      accents.forEach(element => observer ? observer.observe(element) : element.classList.add('trade-in-view'));

      // HeroBanner owns background media loading and playback.
    </script>
  </body>
</html>
