---
// Ruiz Family Enterprises - Root Layout
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/trade-motion.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ruiz Family Enterprises",
  description = "Ruiz Family Enterprises Inc. Masonry, concrete, general engineering and public works in the Central Valley. Call (559) 244-1922 to discuss your project."
} = Astro.props;

const siteUrl = "https://ruizfamilyhardscapes.biz";
const ogImageUrl = `${siteUrl}/images/hero/hero-custom-home-pour.jpg`;

// Business and FAQ structured data withheld until claims have verified sources.

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={siteUrl} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ruiz Family Enterprises Inc" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Preconnect Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- JSON-LD Structured Data -->
  </head>
  <body>
    <!-- Skip to main content for accessibility -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    <script>
      const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
      const accents = document.querySelectorAll('.section-header, .process-steps-grid');
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('trade-in-view');
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.2 });
      accents.forEach(element => observer.observe(element));

      // Background footage rests when it cannot be seen or motion is reduced.
      const video = document.querySelector<HTMLVideoElement>('.hero-bg-video');
      if (video) {
        let inView = false;
        const syncPlayback = () => {
          if (preference.matches || document.hidden || !inView) video.pause();
          else video.play().catch(() => {});
        };
        const videoObserver = new IntersectionObserver(([entry]) => {
          inView = entry?.isIntersecting ?? false;
          syncPlayback();
        });
        videoObserver.observe(video);
        preference.addEventListener('change', syncPlayback);
        document.addEventListener('visibilitychange', syncPlayback);
        syncPlayback();
      }
    </script>
  </body>
</html>
