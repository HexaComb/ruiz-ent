---
import MasonryAccent from './MasonryAccent.astro';
// Ruiz Family Enterprises - Hero Banner with Background Working Video & Infinite Cycling Marquee
// Service names published at https://ruizfamilyhardscapes.biz/ (checked October 24, 2026).
const services = [
  'Block Walls', 'Retaining Walls', 'Decorative Stone', 'Brick Work',
  'Architectural Stone', 'Concrete Patios', 'Concrete Porches', 'Pool Decks',
  'Concrete Driveways', 'Sidewalks', 'Drain and Gutter', 'Concrete Removal',
  'Concrete Steps', 'Stamped Concrete', '3/8″ Concrete Pump Service',
];
---

<section class="section section--dark section--spacious hero-banner" id="hero" aria-labelledby="hero-heading" data-hero-banner>
  <!-- Background Live Video Stage of the Ruiz Crew Working (with fallback poster) -->
  <div class="hero-bg-stage" aria-hidden="true">
    <video
      class="hero-bg-video"
      autoplay
      loop
      muted
      playsinline
      poster="/images/hero/hero-custom-home-pour.jpg"
    >
      <source src="/videos/hero_background_boomerang.webm" type="video/webm" />
      <source src="/videos/hero_background_boomerang.mp4" type="video/mp4" />
    </video>
    <img class="hero-mobile-image" src="/images/hero/hero-custom-home-pour.jpg" alt="" loading="eager" fetchpriority="high" />
    <div class="hero-scrim"></div>
  </div>

  <div class="container hero-container grid-2">
    <div class="hero-copy-block stack stack--lg">
      <!-- Credential Authority Line -->
      <div class="hero-credential-bar">
        <span>Masonry &amp; Concrete · License #1055499 · Three Generations</span>
      </div>

      <!-- Main Headline -->
      <h1 class="hero-title" id="hero-heading">
        <span class="hero-title-line">Hardscapes Built for Generations.</span>
      </h1>

      <!-- Story Narrative -->
      <p class="hero-description">From patios and pool decks to block walls and architectural stone, Ruiz Family Enterprises brings three generations of masonry and concrete experience to residential and commercial projects.</p>

      <!-- Action Buttons -->
      <div class="hero-actions cluster cluster--sm">
        <a href="#quote-builder" class="btn btn-primary hero-btn-main">
          <span>Discuss a Project</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a href="#our-work" class="btn btn-outline-light hero-btn-sub">
          <span>Explore Project Media</span>
          <span aria-hidden="true">&darr;</span>
        </a>
      </div>

      <!-- Quick Direct Contact Line -->
      <div class="hero-direct-call cluster cluster--sm">
        <span class="call-lead">Prefer to speak right now?</span>
        <a href="tel:+15592441922" class="call-link">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01l-2.2 2.2z"/>
          </svg>
          <span>Call: (559) 244-1922</span>
        </a>
      </div>
    </div>
    <MasonryAccent />
  </div>
</section>

<!-- Published masonry and concrete services -->
<div class="hero-sectors-bar" aria-label="Masonry and concrete services">
    <div class="sectors-bar-inner">
      <div class="sectors-lead">
        <span class="lead-label">Services:</span>
      </div>

      <div class="sectors-viewport">
        <!-- impeccable-disable-next-line marquee -- User requested continuous cycle bar of published services -->
        <div class="sectors-track">
          <!-- Set 1 -->
          {services.map((service) => (
            <div class="sector-entry">
              <span class="sector-name">{service}</span>
              <span class="sector-sep" aria-hidden="true">&bull;</span>
            </div>
          ))}
          <!-- Set 2 (Duplicated for seamless continuous scroll) -->
          {services.map((service) => (
            <div class="sector-entry" aria-hidden="true">
              <span class="sector-name">{service}</span>
              <span class="sector-sep">&bull;</span>
            </div>
          ))}
        </div>
      </div>
    </div>
</div>

<style>
  .hero-banner {
    position: relative;
    min-height: calc(100svh - 162px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    background-color: var(--bg-dark-deep);
    color: #ffffff;
    overflow: hidden;
    isolation: isolate;
  }

  /* Background Video Stage */
  .hero-bg-stage {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  .hero-bg-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: brightness(0.72) contrast(1.08);
    pointer-events: none;
  }

  .hero-mobile-image {
    display: none;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(8, 13, 20, 0.88) 0%,
      rgba(8, 13, 20, 0.92) 50%,
      rgba(8, 13, 20, 0.98) 100%
    );
  }

  @media (min-width: 900px) {
    .hero-scrim {
      background: linear-gradient(
        90deg,
        rgba(8, 13, 20, 0.96) 0%,
        rgba(8, 13, 20, 0.88) 48%,
        rgba(8, 13, 20, 0.78) 100%
      );
    }
  }

  /* Hero Content */
  .hero-container {
    position: relative;
    z-index: 2;
    align-items: center;
    gap: var(--space-grid-gap-lg);
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
  }

  @media (max-width: 999px) {
    .hero-container { grid-template-columns: minmax(0, 1fr); }
  }

  .hero-copy-block {
    max-width: 780px;
  }

  .hero-credential-bar {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-weight: 600;
    color: #93c5fd;
    letter-spacing: 0.01em;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #ffffff;
  }

  .hero-title-line {
    display: block;
    background-image: url("/images/materials/concrete.png");
    background-size: 320px 320px;
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    filter: drop-shadow(0 2px 1px rgba(0, 0, 0, 0.5));
  }

  .hero-description {
    font-size: clamp(1.05rem, 1.35vw, 1.2rem);
    line-height: 1.65;
    color: #e2e8f0;
    max-width: 65ch;
  }

  .hero-actions {
    align-items: center;
  }

  .hero-btn-main {
    padding: var(--space-4) var(--space-8);
    font-size: 1.05rem;
  }

  .hero-btn-sub {
    padding: var(--space-4) var(--space-8);
    font-size: 1.02rem;
  }

  .hero-direct-call {
    align-items: center;
    font-size: 0.94rem;
  }

  .call-lead {
    color: #cbd5e1;
  }

  .call-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: #93c5fd;
    font-family: var(--font-mono);
    font-weight: 700;
    transition: color 0.15s ease;
  }

  .call-link:hover {
    color: #ffffff;
    text-decoration: underline;
  }

  /* Ultra-Premium Sectors Bar */
  .hero-sectors-bar {
    position: relative;
    z-index: 2;
    background: rgba(8, 13, 20, 0.84);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-top: 1px solid rgba(255, 255, 255, 0.09);
    min-height: 52px;
    display: flex;
    align-items: center;
  }

  .sectors-bar-inner {
    display: flex;
    align-items: center;
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--space-gutter);
    height: 100%;
    gap: var(--space-5);
  }

  .sectors-lead {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    padding-right: var(--space-5);
    border-right: 1px solid rgba(255, 255, 255, 0.12);
    height: 22px;
  }

  .lead-label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #cbd5e1;
    white-space: nowrap;
  }

  .sectors-viewport {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    position: relative;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000000 24px,
      #000000 calc(100% - 24px),
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000000 24px,
      #000000 calc(100% - 24px),
      transparent 100%
    );
  }

  .sectors-track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: marquee 65s linear infinite;
    will-change: transform;
  }

  .sectors-viewport:hover .sectors-track {
    animation-play-state: paused;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sectors-track {
      animation: none;
      width: 100%;
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: var(--space-3) 0;
      padding-block: var(--space-4);
    }
    .sector-entry[aria-hidden="true"] { display: none; }
    .sectors-viewport { mask-image: none; -webkit-mask-image: none; }
    .sectors-bar-inner { align-items: flex-start; }
    .sectors-lead { margin-top: var(--space-4); }
  }

  .sector-entry {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .sector-name {
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 600;
    color: #f1f5f9;
    letter-spacing: -0.01em;
    transition: color 0.15s ease;
  }

  .sector-sep {
    color: rgba(245, 158, 11, 0.45);
    font-size: 0.72rem;
    margin-inline: var(--space-6);
  }

  @media (max-width: 640px) {
    .sectors-lead {
      padding-right: var(--space-3);
      border-right: none;
    }

  }
  @media (max-width: 640px) {
    .hero-banner {
      --space-section-y-spacious: var(--space-section-y-compact);
      min-height: 0;
    }
    .hero-bg-video { display: none; }
    .hero-mobile-image {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 54% 36%;
    }
    .hero-scrim {
      background: linear-gradient(180deg, rgba(8, 13, 20, 0.34) 0%, rgba(8, 13, 20, 0.9) 32%, #080d14 55%);
    }
    .hero-copy-block { --stack-gap: var(--space-stack-md); }
    .hero-credential-bar, .hero-description-detail { display: none; }
    .hero-title { font-size: clamp(2rem, 9vw, 2.75rem); line-height: 1.08; text-wrap: balance; }
    .hero-title-line { background: none; color: #ffffff; filter: none; text-shadow: 0 var(--space-1) var(--space-4) rgba(0, 0, 0, 0.6); }
    .hero-description { font-size: 1rem; line-height: 1.6; }
    .hero-actions { width: 100%; }
    .hero-actions .btn { width: 100%; font-size: 1rem; min-height: var(--space-12); }
    .hero-actions .hero-btn-sub { background: transparent; border-color: transparent; padding-block: var(--space-3); }
    .hero-direct-call { justify-content: flex-start; }
    .hero-direct-call .call-lead { display: none; }
    .hero-direct-call .call-link { font-family: var(--font-sans); font-size: 0.9rem; min-height: var(--space-12); }
  }
</style>
