---
// Ruiz Family Enterprises - 4-Step Build Process Component (Polished per Impeccable guidelines)
const steps = [
  {
    "phase": "Getting Started",
    "title": "Free On-Site Estimate",
    "desc": "Tell us about your project. We offer a free on-site estimate to help you take the next step.",
    "highlights": [
      "Discuss your ideas",
      "Free on-site estimate"
    ]
  },
  {
    "phase": "Pre-Construction",
    "title": "Plan the Work",
    "desc": "We coordinate budgets, schedules and material deliveries, working with the design team on your vision.",
    "highlights": [
      "Budget coordination",
      "Scheduling & materials"
    ]
  },
  {
    "phase": "Construction",
    "title": "Bring It to Life",
    "desc": "Our team coordinates the build sequence and production, with attention to quality throughout construction.",
    "highlights": [
      "Build coordination",
      "Quality control"
    ]
  },
  {
    "phase": "Post-Construction",
    "title": "Clean Up & Walk Through",
    "desc": "After construction, we clean the site and carry out a final walkthrough with you.",
    "highlights": [
      "Site cleanup",
      "Final walkthrough"
    ]
  }
];
---

<section class="section section--white process-section" id="our-process" aria-labelledby="process-heading">
  <div class="container">
    <div class="section-header text-center">
      <h2 class="section-title" id="process-heading">
        Project Process
      </h2>
      <p class="section-subtitle centered">From the first estimate to the final walkthrough, we work with you to plan and complete your project.</p>
    </div>

    <!-- Steps Timeline Grid -->
    <div class="process-steps-grid">
      {steps.map((s) => (
        <article class="process-step-card reveal-on-scroll">
          <div class="step-header">
            <span class="step-phase">{s.phase}</span>
          </div>

          <h3 class="step-title">{s.title}</h3>
          <p class="step-desc">{s.desc}</p>

          <ul class="step-bullets">
            {s.highlights.map(h => (
              <li class="bullet-item">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>{h}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <!-- Process Bottom Action -->
    <div class="process-cta-banner">
      <div class="banner-text">
        <h3 class="banner-title">Have a project in mind?</h3>
        <p class="banner-sub">Call us to discuss your ideas and arrange a free on-site estimate.</p>
      </div>
      <div class="banner-actions">
        <a href="#quote-builder" class="btn btn-primary">
          <span>Discuss a Project</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .process-section {
    background-color: var(--bg-white);
  }

  .process-steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 680px) {
    .process-steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .process-steps-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .process-step-card {
    background: var(--bg-light);
    border: 1.5px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: clamp(1.4rem, 2.5vw, 1.85rem);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .process-step-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--ruiz-blue);
  }

  .step-header {
    margin-bottom: 1rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--border-light);
  }

  .step-phase {
    display: block;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ruiz-blue);
  }

  .step-title {
    font-family: var(--font-display);
    font-size: 1.22rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--text-dark);
    margin-bottom: 0.85rem;
  }

  .step-desc {
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--text-dark-secondary);
    margin-bottom: 1.5rem;
    max-width: 65ch;
  }

  .step-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border-light);
  }

  .bullet-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--text-dark-secondary);
  }

  .bullet-item svg {
    color: var(--ruiz-blue);
    flex-shrink: 0;
  }

  /* CTA Banner */
  .process-cta-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    background: #0d1520;
    color: #ffffff;
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  .banner-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.35rem;
  }

  .banner-sub {
    font-size: 0.95rem;
    color: #e2e8f0;
    max-width: 65ch;
  }
</style>
