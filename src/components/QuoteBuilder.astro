---
// Ruiz Family Enterprises - Interactive Quote Builder & Estimate Form Component (Polished per Impeccable guidelines)
---

<section class="estimate-cta-section" id="quote-builder" aria-labelledby="quote-heading">
  <div class="container">
    <div class="estimate-layout-grid">
      <!-- Left Column: Value Proposition & Direct Contact -->
      <div class="estimate-info-col">
        <h2 class="section-title on-dark" id="quote-heading">
          Request Your Free On-Site Project Estimate.
        </h2>
        <p class="estimate-lead-p">
          Tell us about your property and goals. Jose Daniel will come out, evaluate the laser elevations, discuss concrete stamps or split-face masonry options, and prepare an honest, itemized estimate.
        </p>

        <!-- Direct Contact Cards -->
        <div class="estimate-contacts-list">
          <div class="contact-pill-card">
            <div class="contact-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01l-2.2 2.2z"/>
              </svg>
            </div>
            <div class="contact-details">
              <span class="contact-sub">Direct Line to Jose Ruiz</span>
              <a href="tel:+15592441922" class="contact-val">(559) 244-1922</a>
            </div>
          </div>

          <div class="contact-pill-card">
            <div class="contact-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
              </svg>
            </div>
            <div class="contact-details">
              <span class="contact-sub">Office &amp; Plans Email</span>
              <a href="mailto:ruizfamilyent@gmail.com" class="contact-val">ruizfamilyent@gmail.com</a>
            </div>
          </div>

          <div class="contact-pill-card">
            <div class="contact-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
              </svg>
            </div>
            <div class="contact-details">
              <span class="contact-sub">Headquarters &amp; Service Region</span>
              <span class="contact-val-static">Kingsburg &bull; Selma &bull; Fresno &bull; Clovis</span>
            </div>
          </div>
        </div>

        <!-- Trust Badges -->
        <div class="estimate-trust-footer">
          <span class="trust-item">&check; CSLB #1055499 Licensed &amp; Bonded</span>
          <span class="trust-item">&check; 100% Free, No-Obligation Consultation</span>
          <span class="trust-item">&check; Commercial Liability &amp; Workers&rsquo; Comp</span>
        </div>
      </div>

      <!-- Right Column: Interactive Project Request Form -->
      <div class="estimate-form-col">
        <form class="quote-form-card" id="quoteForm" novalidate>
          <div class="form-header">
            <h3 class="form-title">Tell Us About Your Hardscape Project</h3>
            <p class="form-sub">Select your project type and details below.</p>
          </div>

          <!-- Step 1: Project Type Selection -->
          <div class="form-step-block">
            <label class="step-label">Select Project Type</label>
            <div class="type-pill-grid" role="radiogroup" aria-label="Project Type">
              <label class="type-pill is-selected">
                <input type="radio" name="projectType" value="Decorative Concrete Patio & Pool Deck" checked />
                <span class="pill-title">Concrete Patio &amp; Pool Deck</span>
                <span class="pill-desc">Stamped, colored, or broom finish</span>
              </label>

              <label class="type-pill">
                <input type="radio" name="projectType" value="Split-Face Block or Retaining Wall" />
                <span class="pill-title">Block or Retaining Wall</span>
                <span class="pill-desc">Privacy, perimeter, or soil retention</span>
              </label>

              <label class="type-pill">
                <input type="radio" name="projectType" value="Dry-Stacked Stone & Firepit" />
                <span class="pill-title">Stone Veneer &amp; Firepit</span>
                <span class="pill-desc">Brick replacement &amp; outdoor living</span>
              </label>

              <label class="type-pill">
                <input type="radio" name="projectType" value="Foundations, Garage Slab or Line Pump" />
                <span class="pill-title">Foundation &amp; Line Pump</span>
                <span class="pill-desc">Garage slabs, sports courts &amp; pumping</span>
              </label>
            </div>
          </div>

          <!-- Step 2: Estimated Scope -->
          <div class="form-step-block">
            <label class="step-label">Estimated Scope / Area</label>
            <div class="scope-pill-row" role="radiogroup" aria-label="Project Scope">
              <label class="scope-pill is-selected">
                <input type="radio" name="projectScope" value="Under 500 sq ft / Under 50 LF" checked />
                <span>Small (&lt; 500 sq ft)</span>
              </label>
              <label class="scope-pill">
                <input type="radio" name="projectScope" value="500 - 1,500 sq ft / 50 - 200 LF" />
                <span>Medium (500&ndash;1,500 sq ft)</span>
              </label>
              <label class="scope-pill">
                <input type="radio" name="projectScope" value="1,500+ sq ft / 200+ LF Estate" />
                <span>Large / Estate (1,500+ sq ft)</span>
              </label>
            </div>
          </div>

          <!-- Step 3: Contact Fields -->
          <div class="form-step-block">
            <label class="step-label">Your Contact &amp; Property Information</label>
            <div class="fields-grid">
              <div class="form-group">
                <label for="clientName" class="input-label">Full Name *</label>
                <input type="text" id="clientName" name="name" class="form-input" required placeholder="Jose Rodriguez" />
                <span class="field-error" id="nameError" hidden>Please provide your name.</span>
              </div>

              <div class="form-group">
                <label for="clientPhone" class="input-label">Phone Number *</label>
                <input type="tel" id="clientPhone" name="phone" class="form-input" required placeholder="(559) 000-0000" />
                <span class="field-error" id="phoneError" hidden>Please provide a valid phone number.</span>
              </div>

              <div class="form-group">
                <label for="clientEmail" class="input-label">Email Address *</label>
                <input type="email" id="clientEmail" name="email" class="form-input" required placeholder="you@example.com" />
                <span class="field-error" id="emailError" hidden>Please provide a valid email.</span>
              </div>

              <div class="form-group">
                <label for="clientCity" class="input-label">City or Address in Central Valley *</label>
                <input type="text" id="clientCity" name="city" class="form-input" required placeholder="Kingsburg, Fresno, Clovis, Selma..." />
                <span class="field-error" id="cityError" hidden>Please enter your city.</span>
              </div>
            </div>

            <div class="form-group full-width">
              <label for="clientMessage" class="input-label">Project Details &amp; Ideas (Optional)</label>
              <textarea id="clientMessage" name="message" class="form-textarea" rows="3" placeholder="Tell us about the existing yard, narrow access, desired finish, or approximate dimensions..."></textarea>
            </div>
          </div>

          <!-- Submit Button -->
          <button type="submit" class="btn btn-primary submit-btn" id="submitBtn">
            <span>Request My Free On-Site Estimate</span>
            <span aria-hidden="true">&rarr;</span>
          </button>

          <!-- Feedback Status Box -->
          <div class="form-status" id="formStatus" hidden role="alert" aria-live="polite"></div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .estimate-cta-section {
    padding-block: var(--space-section-y);
    background-color: var(--bg-dark);
    color: #ffffff;
    position: relative;
    overflow: hidden;
  }

  .estimate-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: flex-start;
  }

  @media (min-width: 960px) {
    .estimate-layout-grid {
      grid-template-columns: 1.05fr 1.35fr;
      gap: 4.5rem;
    }
  }

  /* Info Column */
  .estimate-info-col {
    display: flex;
    flex-direction: column;
  }

  .estimate-lead-p {
    font-size: 1.08rem;
    line-height: 1.7;
    color: var(--text-light-secondary);
    margin-block: 1rem 2rem;
    max-width: 65ch;
  }

  .estimate-contacts-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .contact-pill-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    background: #141f2e;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-md);
    padding: 1.1rem 1.4rem;
    transition: border-color 0.15s ease;
  }

  .contact-pill-card:hover {
    border-color: rgba(147, 197, 253, 0.35);
  }

  .contact-icon {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--ruiz-blue);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .contact-sub {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-light-muted);
  }

  .contact-val {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 800;
    color: #ffffff;
    transition: color 0.15s ease;
  }

  .contact-val:hover {
    color: #93c5fd;
  }

  .contact-val-static {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
  }

  .estimate-trust-footer {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: #cbd5e1;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .trust-item {
    color: #93c5fd;
  }

  /* Form Column (Solid contractor card, crisp border) */
  .quote-form-card {
    background: #ffffff;
    color: var(--text-dark);
    border-radius: var(--radius-lg);
    border: 1.5px solid var(--border-light);
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
    box-shadow: var(--shadow-md);
  }

  .form-header {
    margin-bottom: 2rem;
  }

  .form-title {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 0.35rem;
  }

  .form-sub {
    font-size: 0.94rem;
    color: var(--text-dark-secondary);
  }

  .form-step-block {
    margin-bottom: 1.75rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-light);
  }

  .step-label {
    display: block;
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 0.85rem;
  }

  /* Type Pills */
  .type-pill-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 600px) {
    .type-pill-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .type-pill {
    display: flex;
    flex-direction: column;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-md);
    border: 1.5px solid var(--border-light);
    background: var(--bg-light);
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .type-pill input {
    position: absolute;
    opacity: 0;
  }

  .type-pill.is-selected {
    border-color: var(--ruiz-blue);
    background: rgba(15, 63, 171, 0.06);
  }

  .pill-title {
    font-family: var(--font-display);
    font-size: 0.94rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 0.2rem;
  }

  .pill-desc {
    font-size: 0.8rem;
    color: var(--text-dark-secondary);
  }

  /* Scope Pills */
  .scope-pill-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .scope-pill {
    flex: 1;
    min-width: 140px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1.5px solid var(--border-light);
    background: var(--bg-light);
    cursor: pointer;
    font-size: 0.88rem;
    font-weight: 600;
    text-align: center;
    transition: all 0.15s ease;
  }

  .scope-pill input {
    position: absolute;
    opacity: 0;
  }

  .scope-pill.is-selected {
    border-color: var(--ruiz-blue);
    background: var(--ruiz-blue);
    color: #ffffff;
  }

  /* Input Fields */
  .fields-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  @media (min-width: 600px) {
    .fields-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-group.full-width {
    grid-column: 1 / -1;
  }

  .input-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-dark);
  }

  .form-input, .form-textarea {
    width: 100%;
    padding: 0.75rem 0.95rem;
    border-radius: var(--radius-md);
    border: 1.5px solid var(--border-light-strong);
    background: #ffffff;
    color: var(--text-dark);
    font-size: 0.95rem;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .form-input:focus, .form-textarea:focus {
    outline: none;
    border-color: var(--ruiz-blue);
    box-shadow: 0 0 0 3px rgba(15, 63, 171, 0.15);
  }

  .field-error {
    font-size: 0.8rem;
    color: var(--state-error);
    font-weight: 600;
  }

  .submit-btn {
    width: 100%;
    padding: 1.05rem;
    font-size: 1.05rem;
  }

  /* Form Status */
  .form-status {
    margin-top: 1.25rem;
    padding: 1.1rem 1.35rem;
    border-radius: var(--radius-md);
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .form-status.is-success {
    background: #f0fdf4;
    border: 1.5px solid #86efac;
    color: #14532d;
  }

  .form-status.is-error {
    background: #fef2f2;
    border: 1.5px solid #fca5a5;
    color: #7f1d1d;
  }
</style>

<script>
  document.querySelectorAll<HTMLLabelElement>('.type-pill').forEach(pill => {
    pill.addEventListener('click', () => {
      document.querySelectorAll<HTMLLabelElement>('.type-pill').forEach(p => p.classList.remove('is-selected'));
      pill.classList.add('is-selected');
    });
  });

  document.querySelectorAll<HTMLLabelElement>('.scope-pill').forEach(pill => {
    pill.addEventListener('click', () => {
      document.querySelectorAll<HTMLLabelElement>('.scope-pill').forEach(p => p.classList.remove('is-selected'));
      pill.classList.add('is-selected');
    });
  });

  const form = document.getElementById('quoteForm') as HTMLFormElement;
  const statusBox = document.getElementById('formStatus') as HTMLElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const nameInput = document.getElementById('clientName') as HTMLInputElement;
    const phoneInput = document.getElementById('clientPhone') as HTMLInputElement;
    const emailInput = document.getElementById('clientEmail') as HTMLInputElement;
    const cityInput = document.getElementById('clientCity') as HTMLInputElement;

    let hasError = false;

    if (!nameInput.value.trim()) {
      document.getElementById('nameError')!.hidden = false;
      nameInput.focus();
      hasError = true;
    } else {
      document.getElementById('nameError')!.hidden = true;
    }

    if (!phoneInput.value.trim() || phoneInput.value.replace(/\D/g, '').length < 7) {
      document.getElementById('phoneError')!.hidden = false;
      if (!hasError) phoneInput.focus();
      hasError = true;
    } else {
      document.getElementById('phoneError')!.hidden = true;
    }

    if (!emailInput.value.trim() || !emailInput.value.includes('@')) {
      document.getElementById('emailError')!.hidden = false;
      if (!hasError) emailInput.focus();
      hasError = true;
    } else {
      document.getElementById('emailError')!.hidden = true;
    }

    if (!cityInput.value.trim()) {
      document.getElementById('cityError')!.hidden = false;
      if (!hasError) cityInput.focus();
      hasError = true;
    } else {
      document.getElementById('cityError')!.hidden = true;
    }

    if (hasError) return;

    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span>Sending Request to Jose & Marlin...</span>';

    setTimeout(() => {
      submitBtn.disabled = false;
      submitBtn.innerHTML = '<span>Request Sent &check;</span>';
      
      const refNumber = 'RF-' + Math.floor(1000 + Math.random() * 9000);
      statusBox.hidden = false;
      statusBox.className = 'form-status is-success';
      statusBox.innerHTML = `
        <strong>Estimate Request Received (Ref #${refNumber}):</strong><br/>
        Thank you, ${nameInput.value.trim()}! Jose or Marlin Ruiz will review your project details and call you at ${phoneInput.value.trim()} within 24 hours to schedule your on-site walkthrough. If you need immediate assistance, call Jose directly at (559) 244-1922.
      `;

      form.reset();
      document.querySelectorAll<HTMLLabelElement>('.type-pill')[0].classList.add('is-selected');
      document.querySelectorAll<HTMLLabelElement>('.scope-pill')[0].classList.add('is-selected');
    }, 600);
  });
</script>
