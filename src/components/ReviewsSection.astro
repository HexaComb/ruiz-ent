---
const sourceUrl = 'https://ruizfamilyhardscapes.biz/testimonials';
const reviews = [
  {
    author: 'Rachel Jacobsen',
    scope: 'Dry-Stacked Stone',
    excerpt: 'The end result is absolutely amazing!',
    summary: 'Rachel describes replacing brick accents with dry-stacked stone and praises the result, friendly crew and cleanup.'
  },
  {
    author: 'Ravi Somayajulu',
    scope: 'Concrete & Wall',
    excerpt: 'He and his crew were tremendous',
    summary: 'Ravi praises Jose and the crew for completing concrete and wall work according to plan and accommodating project changes.'
  },
  {
    author: 'Danny Runs',
    scope: 'Block Walls',
    excerpt: 'Highly recommended.',
    summary: 'Danny reports adding two block walls and praises the friendly crew and workmanship.'
  },
  {
    author: 'Alfredo Luviano',
    scope: 'Customer Experience',
    excerpt: 'He has great prices',
    summary: 'Alfredo highlights the professional work, pricing and approachable communication.'
  },
  {
    author: 'Patty Mendoza',
    scope: 'Customer Experience',
    excerpt: 'They arrived on time',
    summary: 'Patty praises the communication, attention to detail, budget and timely completion.'
  }
];
const initials = (author: string) => author.split(' ').map((part) => part[0]).slice(0, 2).join('');
---

<section class="section section--dark reviews-section" id="reviews" aria-labelledby="reviews-heading">
  <div class="container">
    <div class="reviews-header grid-2">
      <h2 class="section-title on-dark" id="reviews-heading">
        <span>Their Words.</span>
        <span>Our Work.</span>
      </h2>
      <p class="section-subtitle on-dark">Hear from customers who trusted us with their concrete and masonry projects.</p>
    </div>

    <div class="conversation-scene">
      <div class="conversation-bubbles grid-2">
        {reviews.slice(0, 2).map((review) => (
          <article class="conversation-bubble stack stack--md">
            <div class="reviewer">
              <span class="review-avatar" aria-hidden="true">{initials(review.author)}</span>
              <div class="stack stack--xs">
                <h3 class="reviewer-name">{review.author}</h3>
                <p class="reviewer-type">Customer testimonial</p>
              </div>
            </div>
            <p class="review-scope">{review.scope}</p>
            <blockquote class="review-excerpt">“{review.excerpt}”</blockquote>
          </article>
        ))}
      </div>
      <div class="scene-art">
        <!-- unDraw Construction workers: https://undraw.co/illustration/construction-workers_z99i -->
        <img src="/images/reviews/construction-workers-undraw.svg" alt="" width="800" height="484" loading="lazy" />
      </div>
    </div>

    <div class="reviews-grid grid-3">
      {reviews.slice(2).map((review) => (
        <article class="review-card stack stack--lg">
          <div class="reviewer">
            <span class="review-avatar" aria-hidden="true">{initials(review.author)}</span>
            <div class="stack stack--xs">
              <h3 class="reviewer-name">{review.author}</h3>
              <p class="reviewer-type">Customer testimonial</p>
            </div>
          </div>
          <blockquote class="review-card-excerpt">“{review.excerpt}”</blockquote>
          <p class="review-card-text">{review.summary}</p>
          <p class="review-scope">{review.scope}</p>
        </article>
      ))}
    </div>

    <div class="reviews-source cluster cluster--between">
      <p>Review excerpts and summaries from published testimonials.</p>
      <a href={sourceUrl}>
        Read the original testimonials
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .reviews-section {
    scroll-margin-block-start: var(--space-20);
  }

  .reviews-header {
    align-items: end;
    margin-block-end: var(--space-header-mb);
  }

  .reviews-header .section-title {
    margin-block: var(--space-0);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.03;
  }

  .reviews-header .section-title span {
    display: block;
  }

  .reviews-header .section-title span:last-child {
    color: #b5c9fb;
  }

  .reviews-header .section-subtitle {
    max-width: 36ch;
    padding-block-end: var(--space-2);
  }

  .conversation-scene {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-6);
    padding: var(--space-card-p);
    border-radius: var(--radius-lg);
    background: #eef3fb;
  }

  .conversation-bubbles {
    min-width: 0;
    align-items: stretch;
  }

  .conversation-bubble,
  .review-card {
    min-width: 0;
    padding: var(--space-card-p);
    border-radius: var(--radius-lg);
    background: var(--bg-white);
    color: var(--text-dark);
  }

  .conversation-bubble {
    position: relative;
    border: 1px solid #c6d5eb;
  }

  .conversation-bubble::after {
    content: '';
    position: absolute;
    inset-block-end: calc(-1 * var(--space-3));
    inset-inline-start: var(--space-8);
    width: var(--space-6);
    height: var(--space-6);
    border-inline-end: 1px solid #c6d5eb;
    border-block-end: 1px solid #c6d5eb;
    background: var(--bg-white);
    transform: rotate(45deg);
  }

  .reviewer {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .reviewer > .stack {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .review-avatar {
    display: grid;
    place-items: center;
    width: var(--space-12);
    height: var(--space-12);
    flex: none;
    border-radius: 50%;
    background: #e0eaff;
    color: var(--ruiz-blue-dark);
    font-size: 0.84rem;
    font-weight: 800;
  }

  .reviewer-name {
    color: var(--text-dark);
    font-size: 0.95rem;
    font-weight: 800;
    line-height: 1.3;
  }

  .reviewer-type {
    color: var(--text-dark-muted);
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .review-scope {
    color: var(--ruiz-blue-dark);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .review-excerpt {
    color: var(--text-dark);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    font-weight: 700;
    line-height: 1.38;
    text-wrap: balance;
  }

  .scene-art {
    justify-self: end;
    width: 42%;
    max-width: 18rem;
  }

  .scene-art img {
    display: block;
    width: 100%;
    height: auto;
  }

  .reviews-grid {
    grid-template-columns: 1fr;
    margin-block-start: var(--space-12);
  }

  .review-card {
    border: 1px solid var(--border-light);
  }

  .review-card-text {
    flex: 1;
    color: var(--text-dark-secondary);
    font-size: 1rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .review-card-excerpt {
    color: var(--text-dark);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .reviews-source {
    align-items: center;
    gap: var(--space-4);
    padding-block-start: var(--space-8);
    color: var(--text-light-muted);
    font-size: 0.9rem;
  }

  .reviews-source a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--space-12);
    color: var(--text-light);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: #b5c9fb;
    text-underline-offset: var(--space-1);
  }

  .reviews-source a:hover {
    color: #b5c9fb;
  }

  .reviews-source a:focus-visible {
    outline-color: var(--text-light);
  }

  @media (max-width: 767px) {
    .conversation-bubbles {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
      padding-block-end: var(--space-4);
    }

    .conversation-bubble {
      padding: var(--space-card-p-compact);
    }
  }

  @media (min-width: 900px) {
    .conversation-scene {
      grid-template-columns: minmax(0, 4fr) minmax(0, 1fr);
      align-items: end;
      gap: var(--space-8);
    }

    .scene-art {
      width: 100%;
    }
  }

  @media (min-width: 768px) {
    .reviews-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
