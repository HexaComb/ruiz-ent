---
// Ruiz Family Enterprises - Customer Reviews & Testimonials Component
const featuredReviews = [
  {
    "author": "Rachel Jacobsen",
    "scope": "Dry-Stacked Stone",
    "quote": "Rachel describes replacing brick accents with dry-stacked stone and praises the result, friendly crew and cleanup."
  },
  {
    "author": "Ravi Somayajulu",
    "scope": "Concrete & Wall",
    "quote": "Ravi praises Jose and the crew for completing concrete and wall work according to plan and accommodating project changes."
  }
];

const standardReviews = [
  {
    "author": "Danny Runs",
    "scope": "Block Walls",
    "quote": "Danny reports adding two block walls and praises the friendly crew and workmanship."
  },
  {
    "author": "Alfredo Luviano",
    "scope": "Customer Experience",
    "quote": "Alfredo highlights the professional work, pricing and approachable communication."
  },
  {
    "author": "Patty Mendoza",
    "scope": "Customer Experience",
    "quote": "Patty praises the communication, attention to detail, budget and timely completion."
  }
];
---

<section class="section section--white reviews-section" id="reviews" aria-labelledby="reviews-heading">
  <div class="container">
    <div class="reviews-header text-center">
      <h2 class="section-title" id="reviews-heading">
        Customer Reviews
      </h2>
      <p class="section-subtitle centered">Summaries of customer testimonials published on our previous website.</p>

      <div class="rating-strip">
        <a class="rating-highlight" href="https://ruizfamilyhardscapes.biz/testimonials">Read the original testimonials</a>
        <span class="rating-sep" aria-hidden="true">&bull;</span>
        <span class="rating-caption">Customer stories</span>
      </div>
    </div>

    <!-- Editorial Reviews Layout -->
    <div class="reviews-editorial">
      <!-- Tier 1: Prominent In-Depth Client Stories -->
      <div class="reviews-featured-row">
        {featuredReviews.map((r) => (
          <article class="review-card review-card-featured reveal-on-scroll">
            <div class="card-inner">
              <div class="card-meta-top">
                <span class="project-scope">{r.scope}</span>
              </div>

              <p class="review-quote">
                {r.quote}
              </p>

              <footer class="review-byline">
                <span class="author-name">{r.author}</span>
                <span class="author-meta">Testimonial summary</span>
              </footer>
            </div>
          </article>
        ))}
      </div>

      <!-- Tier 2: Focused Trade Projects -->
      <div class="reviews-standard-row">
        {standardReviews.map((r) => (
          <article class="review-card reveal-on-scroll">
            <div class="card-inner">
              <div class="card-meta-top">
                <span class="project-scope">{r.scope}</span>
              </div>

              <p class="review-quote">
                {r.quote}
              </p>

              <footer class="review-byline">
                <span class="author-name">{r.author}</span>
                <span class="author-meta">Testimonial summary</span>
              </footer>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .reviews-section {
    background-color: #ffffff;
  }

  .reviews-header {
    margin-bottom: clamp(2.5rem, 4.5vw, 3.5rem);
  }

  .rating-strip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    margin-top: 1.25rem;
    font-size: 0.92rem;
    color: var(--text-dark-secondary);
  }

  .rating-highlight {
    font-weight: 700;
    color: var(--text-dark);
    letter-spacing: -0.01em;
  }

  .rating-sep {
    color: #94a3b8;
    font-size: 0.65rem;
  }

  .rating-caption {
    color: var(--text-dark-muted);
    font-weight: 500;
  }

  /* Editorial Layout */
  .reviews-editorial {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .reviews-featured-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 860px) {
    .reviews-featured-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .reviews-standard-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 640px) {
    .reviews-standard-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .reviews-standard-row {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Review Card Styling - Restrained, Clean Architectural Aesthetic */
  .review-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: var(--radius-lg);
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .review-card:hover {
    border-color: #cbd5e1;
    box-shadow: 0 10px 24px -4px rgba(15, 23, 42, 0.07);
  }

  .review-card-featured {
    background: #fbfcfe;
    border-color: #dbe4ee;
  }

  .card-inner {
    padding: clamp(1.5rem, 2.4vw, 2rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
  }

  .review-card-featured .card-inner {
    padding: clamp(1.75rem, 3vw, 2.4rem);
  }

  .card-meta-top {
    margin-bottom: 1rem;
  }

  .project-scope {
    display: block;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-dark-muted);
  }

  .review-quote {
    font-family: var(--font-sans);
    font-size: 0.98rem;
    line-height: 1.7;
    color: #1e293b;
    margin-bottom: 1.75rem;
    text-wrap: pretty;
  }

  .review-card-featured .review-quote {
    font-size: 1.05rem;
    line-height: 1.72;
    color: #0f172a;
  }

  .review-byline {
    padding-top: 1.15rem;
    border-top: 1px solid #f1f5f9;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .author-name {
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--text-dark);
  }

  .author-meta {
    font-size: 0.82rem;
    color: var(--text-dark-muted);
  }
</style>
