---
// Ruiz Family Enterprises - FAQ Component (Polished per Impeccable guidelines)
// Built with native mutually exclusive <details name="ruiz-faq"> per modern web accessibility guidance
import { serviceAreaNames } from '../data/service-areas';
const faqs = [
  {
    "question": "What kind of contractor is Ruiz Family Enterprises?",
    "answer": "We are a general engineering contractor with concrete and masonry specialties. We work on industrial, commercial, residential and custom projects across the Central Valley, with a family approach to communication, coordination and craftsmanship."
  },
  {
    "question": "Can you build a concrete patio, driveway or pool deck?",
    "answer": "Yes. Our concrete services include patios, porches, pool decks, driveways, sidewalks and steps, along with stamped concrete. Share the space, finish and use you have in mind so we can discuss your project."
  },
  {
    "question": "Do you build block walls, retaining walls and stone masonry?",
    "answer": "Yes. We offer block walls, retaining walls, decorative and architectural stone, and brick work. We can talk through the masonry work you have in mind and the details of your site."
  },
  {
    "question": "How do I request a free on-site estimate in the Central Valley?",
    "answer": "Call (559) 244-1922 or email ruizfamilyent@gmail.com to discuss a free on-site estimate. Have your project address, approximate dimensions, desired finish and any photos or plans ready to help us understand the scope."
  },
  {
    "question": "What affects the cost of a concrete or masonry project?",
    "answer": "Project size, site access, removal or preparation work, materials and finish can affect the scope and cost. Share your plans and project location so we can discuss a site-specific estimate."
  },
  {
    "question": "How should I compare contractor estimates?",
    "answer": "Compare what each estimate includes, not just the total. Ask about preparation, materials, finish, cleanup, exclusions and scheduling so you understand the proposed scope."
  },
  {
    "question": "What masonry and concrete services do you offer?",
    "answer": "Our masonry services include block and retaining walls, decorative and architectural stone, and brick work. Concrete services include patios, porches, pool decks, driveways, sidewalks, steps, stamped finishes, drain and gutter work, removal, and 3/8-inch concrete pump service. These are specialties within our broader general engineering work, which also includes public works projects."
  },
  {
    "question": "What kinds of projects do you take on?",
    "answer": "We work on residential, commercial, retail, industrial and custom projects. Tell us your location and scope so we can discuss the fit."
  },
  {
    "question": "How did your family learn the trade?",
    "answer": "The craft has been passed down through three generations. Learning alongside a father, grandfather and uncles began in childhood."
  },
  {
    "question": "What is your contractor license number?",
    "answer": "Our published California contractor license number is 1055499. Call us if you need details for your project."
  },
  {
    "question": "Can you help with project planning and zoning requirements?",
    "answer": "We work with clients on budgeting and project coordination and have experience with zoning requirements. Call to discuss the permits or approvals your project may need."
  },
  {
    "question": "What areas do you serve?",
    "answer": `We serve ${serviceAreaNames}, California. Our family team is based in Kingsburg and provides services at customer properties, without a public walk-in location. Call (559) 244-1922 with your project address to discuss your general engineering, concrete or masonry project and scheduling.`
  },
  {
    "question": "How long will my project take?",
    "answer": "Timing depends on the size of the job, the design and site conditions. We discuss scheduling as part of planning your project."
  }
];
---

<section class="section section--white faq-section" id="faq" aria-labelledby="faq-heading">
  <div class="container">
    <div class="section-header text-center">
      <h2 class="section-title" id="faq-heading">
        Ruiz Family Enterprises: Project Questions
      </h2>
      <p class="section-subtitle centered">Explore our <a href="#our-services">general engineering services and specialties</a>, learn <a href="#our-process">how we plan your project</a>, and find answers before you call.</p>
    </div>

    <!-- Accordion Group with Shared Name Attribute for Mutual Exclusivity -->
    <div class="accordion-group">
      {faqs.map((faq, index) => (
        <details class="faq-item reveal-on-scroll" name="ruiz-faq" open={index === 0}>
          <summary class="faq-summary">
            <span class="faq-question-text">{faq.question}</span>
            <span class="faq-icon-wrapper" aria-hidden="true">
              <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </summary>
          <div class="faq-answer-panel">
            <p class="faq-answer-p">{faq.answer}</p>
            {faq.question === "What areas do you serve?" && <p class="faq-answer-p"><a href="/service-areas/">Explore our city service guides</a></p>}
          </div>
        </details>
      ))}
    </div>

    <!-- Extra Questions Card (Clean solid borders) -->
    <div class="faq-extra-card">
      <div class="extra-text">
        <h3 class="extra-title">Every site has its own questions.</h3>
        <p class="extra-sub">Tell us about yours and we’ll talk through the work.</p>
      </div>
      <a href="tel:+15592441922" class="btn btn-primary">
        <span>Call (559) 244-1922</span>
      </a>
    </div>
  </div>
</section>

<style>
  .faq-section {
    background-color: var(--bg-light);
  }

  .accordion-group {
    max-width: 860px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }

  .faq-item {
    background: #ffffff;
    border: 1.5px solid var(--border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .faq-item[open] {
    border-color: var(--ruiz-blue);
    box-shadow: var(--shadow-md);
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1.2rem, 2.5vw, 1.5rem);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-question-text {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text-dark);
  }

  .faq-icon-wrapper {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--bg-light);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ruiz-blue);
    flex-shrink: 0;
    transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .faq-item[open] .faq-icon-wrapper {
    transform: rotate(180deg);
    background: var(--ruiz-blue);
    color: #ffffff;
  }

  .faq-chevron {
    transition: transform 0.2s ease;
  }

  .faq-answer-panel {
    padding: 0 clamp(1.2rem, 2.5vw, 1.5rem) 1.5rem clamp(1.2rem, 2.5vw, 1.5rem);
    border-top: 1px solid var(--border-light);
  }

  .faq-answer-p {
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--text-dark-secondary);
    padding-top: 1rem;
    max-width: 58ch;
    text-wrap: pretty;
  }

  /* Extra Box */
  .faq-extra-card {
    max-width: 860px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 1.75rem 2rem;
    background: #ffffff;
    border: 1.5px solid var(--border-light);
    border-radius: var(--radius-md);
  }

  .extra-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 0.25rem;
  }

  .extra-sub {
    font-size: 0.92rem;
    color: var(--text-dark-secondary);
    max-width: 60ch;
  }
</style>
