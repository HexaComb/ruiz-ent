---
// Ruiz Family Enterprises - FAQ Component (Polished per Impeccable guidelines)
// Built with native mutually exclusive <details name="ruiz-faq"> per modern web accessibility guidance
const faqs = [
  {
    "question": "Do you offer free on-site estimates?",
    "answer": "Yes. We offer free on-site estimates. Call (559) 244-1922 to discuss your project."
  },
  {
    "question": "What masonry and concrete services do you offer?",
    "answer": "Our services include block and retaining walls, decorative and architectural stone, brick work, patios, pool decks, driveways, sidewalks, steps, stamped concrete, concrete removal, drain and gutter work, and 3/8-inch concrete pumping."
  },
  {
    "question": "How did your family learn the trade?",
    "answer": "The craft has been passed down through three generations. Learning alongside a father, grandfather and uncles began in childhood."
  },
  {
    "question": "What is your contractor license number?",
    "answer": "Our published contractor license number is 1055499. Additional qualification, bonding and insurance details: Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
  },
  {
    "question": "Can you help with project planning and zoning requirements?",
    "answer": "We work with clients on budgeting and project coordination and have experience with zoning requirements. Specific permit and HOA arrangements: Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
  },
  {
    "question": "What areas do you serve?",
    "answer": "Our contact page lists Kingsburg, California, and our gallery page also lists Selma. Full service-area details: Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
  },
  {
    "question": "How long will my project take?",
    "answer": "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
  }
];
---

<section class="section section--white faq-section" id="faq" aria-labelledby="faq-heading">
  <div class="container">
    <div class="section-header text-center">
      <h2 class="section-title" id="faq-heading">
        Questions &amp; Answers
      </h2>
      <p class="section-subtitle centered">Learn about our services, family background and estimates. Call us with questions about your project.</p>
    </div>

    <!-- Accordion Group with Shared Name Attribute for Mutual Exclusivity -->
    <div class="accordion-group">
      {faqs.map((faq, index) => (
        <details class="faq-item reveal-on-scroll" name="ruiz-faq" open={index === 0}>
          <summary class="faq-summary">
            <span class="faq-question-text">{faq.question}</span>
            <span class="faq-icon-wrapper" aria-hidden="true">
              <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </summary>
          <div class="faq-answer-panel">
            <p class="faq-answer-p">{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- Extra Questions Card (Clean solid borders) -->
    <div class="faq-extra-card">
      <div class="extra-text">
        <h3 class="extra-title">Have a specific question about your project?</h3>
        <p class="extra-sub">Contact the company to discuss your project.</p>
      </div>
      <a href="tel:+15592441922" class="btn btn-primary">
        <span>Call (559) 244-1922</span>
      </a>
    </div>
  </div>
</section>

<style>
  .faq-section {
    background-color: var(--bg-light);
  }

  .accordion-group {
    max-width: 860px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }

  .faq-item {
    background: #ffffff;
    border: 1.5px solid var(--border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .faq-item[open] {
    border-color: var(--ruiz-blue);
    box-shadow: var(--shadow-md);
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1.2rem, 2.5vw, 1.5rem);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-question-text {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text-dark);
  }

  .faq-icon-wrapper {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--bg-light);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ruiz-blue);
    flex-shrink: 0;
    transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .faq-item[open] .faq-icon-wrapper {
    transform: rotate(180deg);
    background: var(--ruiz-blue);
    color: #ffffff;
  }

  .faq-chevron {
    transition: transform 0.2s ease;
  }

  .faq-answer-panel {
    padding: 0 clamp(1.2rem, 2.5vw, 1.5rem) 1.5rem clamp(1.2rem, 2.5vw, 1.5rem);
    border-top: 1px solid var(--border-light);
  }

  .faq-answer-p {
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--text-dark-secondary);
    padding-top: 1rem;
    max-width: 58ch;
    text-wrap: pretty;
  }

  /* Extra Box */
  .faq-extra-card {
    max-width: 860px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 1.75rem 2rem;
    background: #ffffff;
    border: 1.5px solid var(--border-light);
    border-radius: var(--radius-md);
  }

  .extra-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 0.25rem;
  }

  .extra-sub {
    font-size: 0.92rem;
    color: var(--text-dark-secondary);
    max-width: 60ch;
  }
</style>
