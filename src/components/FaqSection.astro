---
// Ruiz Family Enterprises - FAQ Component (Polished per Impeccable guidelines)
// Built with native mutually exclusive <details name="ruiz-faq"> per modern web accessibility guidance
const faqs = [
  {
    question: "Do you offer free on-site project estimates?",
    answer: "Yes, absolutely. Jose Daniel Ruiz will personally visit your property to evaluate elevations, inspect soil conditions and drainage slopes with a laser transit, discuss decorative patterns, and provide a comprehensive, transparent written estimate with zero pressure."
  },
  {
    question: "Why is water curing so essential on new concrete in the Central Valley?",
    answer: "Concrete does not harden by drying—it cures through chemical hydration between Portland cement and water. In the hot, dry Central Valley climate, surface moisture evaporates rapidly, leading to surface flaking and spiderweb micro-cracks. Ruiz Family Enterprises performs an essential multi-day water cure to maximize surface hardness, durability, and compressive PSI strength."
  },
  {
    question: "How does your 3/8\" concrete line pump service work for tight yards?",
    answer: "A standard concrete transit mixer truck weighs up to 60,000 lbs and can easily crack residential pavers or sink into soft lawn turf. Our specialized 3/8\" line pump routes fresh concrete through narrow 3-to-4 foot side gates and around mature landscaping directly to the pour zone without heavy equipment ever touching your lawn."
  },
  {
    question: "What licensing, bonding, and insurance do you hold?",
    answer: "Ruiz Family Enterprises Inc is licensed by the California Contractors State License Board under CSLB #1055499 as a Class A General Engineering Contractor, with specialty C-8 Concrete and C-29 Masonry classifications. We maintain comprehensive commercial liability insurance and full workers' compensation coverage."
  },
  {
    question: "Do you handle local zoning laws, HOA requirements, and municipal permits?",
    answer: "Yes. From property boundary setbacks in Kingsburg and Selma to hillside retaining wall engineering in Fresno and Clovis, our Class A General Engineering credentials mean we understand structural codes, weep hole drainage requirements, and municipal inspection standards from start to finish."
  },
  {
    question: "Can you remove old, cracked concrete or outdated brick before pouring?",
    answer: "Yes, complete demolition and prep is standard for us. We break out old crumbling concrete, remove outdated 1970s/80s brick wainscoting, haul the debris away for eco-friendly recycling, re-grade the soil, and install compacted aggregate base with elevated rebar reinforcement."
  }
];
---

<section class="faq-section" id="faq" aria-labelledby="faq-heading">
  <div class="container">
    <div class="section-header text-center">
      <h2 class="section-title" id="faq-heading">
        Answers Before We Step on Your Property.
      </h2>
      <p class="section-subtitle centered">
        Straightforward, honest guidance on concrete curing, structural masonry, permits, and jobsite logistics.
      </p>
    </div>

    <!-- Accordion Group with Shared Name Attribute for Mutual Exclusivity -->
    <div class="accordion-group">
      {faqs.map((faq, index) => (
        <details class="faq-item reveal-on-scroll" name="ruiz-faq" open={index === 0}>
          <summary class="faq-summary">
            <span class="faq-question-text">{faq.question}</span>
            <span class="faq-icon-wrapper" aria-hidden="true">
              <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </summary>
          <div class="faq-answer-panel">
            <p class="faq-answer-p">{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- Extra Questions Card (Clean solid borders) -->
    <div class="faq-extra-card">
      <div class="extra-text">
        <h3 class="extra-title">Have a specific question about your project?</h3>
        <p class="extra-sub">Jose &amp; Marlin are always happy to chat through ideas, soil types, and timelines.</p>
      </div>
      <a href="tel:+15592441922" class="btn btn-primary">
        <span>Call (559) 244-1922</span>
      </a>
    </div>
  </div>
</section>

<style>
  .faq-section {
    padding-block: var(--space-section-y);
    background-color: var(--bg-light);
  }

  .accordion-group {
    max-width: 860px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }

  .faq-item {
    background: #ffffff;
    border: 1.5px solid var(--border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .faq-item[open] {
    border-color: var(--ruiz-blue);
    box-shadow: var(--shadow-md);
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1.2rem, 2.5vw, 1.5rem);
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-question-text {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text-dark);
  }

  .faq-icon-wrapper {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--bg-light);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ruiz-blue);
    flex-shrink: 0;
    transition: transform 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .faq-item[open] .faq-icon-wrapper {
    transform: rotate(180deg);
    background: var(--ruiz-blue);
    color: #ffffff;
  }

  .faq-chevron {
    transition: transform 0.2s ease;
  }

  .faq-answer-panel {
    padding: 0 clamp(1.2rem, 2.5vw, 1.5rem) 1.5rem clamp(1.2rem, 2.5vw, 1.5rem);
    border-top: 1px solid var(--border-light);
  }

  .faq-answer-p {
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--text-dark-secondary);
    padding-top: 1rem;
    max-width: 58ch;
    text-wrap: pretty;
  }

  /* Extra Box */
  .faq-extra-card {
    max-width: 860px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 1.75rem 2rem;
    background: #ffffff;
    border: 1.5px solid var(--border-light);
    border-radius: var(--radius-md);
  }

  .extra-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: 0.25rem;
  }

  .extra-sub {
    font-size: 0.92rem;
    color: var(--text-dark-secondary);
    max-width: 60ch;
  }
</style>
