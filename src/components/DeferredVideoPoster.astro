---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  widths: number[];
  sizes: string;
  fit?: 'cover' | 'contain';
}
const { src, widths, sizes, fit = 'cover' } = Astro.props;
const candidates = [...new Set([...widths.filter(width => width < src.width), src.width])].sort((a, b) => a - b);
const image = await getImage({ src, widths: candidates, width: src.width, format: 'webp', quality: 80 });
---
<!-- Unlike video.poster, these URLs are inert until the media approaches the viewport.
     Keep an ordinary lazy image for visitors without JavaScript. -->
<img data-video-poster data-src={image.src} data-srcset={image.srcSet.attribute}
  sizes={sizes} width={src.width} height={src.height} alt="" aria-hidden="true"
  decoding="async" class="video-poster" style:object-fit={fit} />
<noscript><img src={image.src} srcset={image.srcSet.attribute} sizes={sizes}
  width={src.width} height={src.height} alt="" aria-hidden="true" loading="lazy"
  decoding="async" class="video-poster" style:object-fit={fit} /></noscript>

<style>
  .video-poster { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .video-poster[hidden] { display: none; }
</style>

<script>
  import { initVideoPoster } from '../lib/video-poster';
  let cleanups: Array<() => void> = [];
  function cleanup() { cleanups.forEach(dispose => dispose()); cleanups = []; }
  function init() {
    cleanup();
    document.querySelectorAll<HTMLImageElement>('[data-video-poster]').forEach(image => {
      cleanups.push(initVideoPoster(image));
    });
  }
  init();
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', cleanup);
</script>
