---
// Ruiz Family Enterprises - Services Overview Carousel Component
// Service carousel with architectural underline tabs and consistent card sizing.
// No pills, no status lights, no arbitrary numbering.
import Section from './Section.astro';

const services = [
  {
    "id": "custom-concrete",
    "tabLabel": "Custom Concrete",
    "title": "Custom Concrete Patios",
    "lead": "Concrete shaped around the home",
    "tags": ["Residential concrete"],
    "description": "Ruiz shared this custom-home hardscape pour as part of a multi-phase project. The company also lists patios, porches, pool decks, driveways and stamped concrete among its services.",
    "bullets": ["Custom concrete patios", "Porches & pool decks", "Driveways & stamped concrete"],
    "quoteType": "Concrete Flatwork & Finishes",
    "image": "/images/services/custom-home-concrete-pour.jpg",
    "alt": "Ruiz crew placing concrete beside a custom home",
    "projectUrl": "https://www.instagram.com/ruiz_family_ent/p/DeflZ4hj9Se/"
  },
  {
    "id": "sidewalks-flatwork",
    "tabLabel": "Sidewalks",
    "title": "Sidewalks & Concrete Flatwork",
    "lead": "Walkways built in phases",
    "tags": ["Concrete flatwork"],
    "description": "Recent project posts show Ruiz forming and pouring sidewalks through multiple phases. Sidewalks, concrete steps and drain and gutter work also appear on the company’s service list.",
    "bullets": ["Sidewalks & walkways", "Concrete steps", "Drain & gutter work"],
    "quoteType": "Concrete Flatwork & Finishes",
    "image": "/images/engineering/flow/photo-1528.webp",
    "alt": "New concrete sidewalk and curb beside a street work zone",
    "projectUrl": "https://www.instagram.com/ruiz_family_ent/reel/DeuxeCFhr78/"
  },
  {
    "id": "stone-masonry",
    "tabLabel": "Stone Masonry",
    "title": "Natural Stone Masonry",
    "lead": "Stonework built by the Ruiz crew",
    "tags": ["Masonry"],
    "description": "Ruiz shares in-progress stone masonry and finished natural-stone details from custom projects. Its website also lists decorative stone, architectural stone and brick work.",
    "bullets": ["Natural stone masonry", "Decorative & architectural stone", "Brick work"],
    "quoteType": "Architectural Stone & Brick Work",
    "image": "/images/services/stone-masonry-project.jpg",
    "alt": "Close view of a natural stone masonry wall in progress",
    "projectUrl": "https://www.instagram.com/ruiz_family_ent/p/DdkQ3Qgjy1g/"
  },
  {
    "id": "concrete-pads",
    "tabLabel": "Concrete Pads",
    "title": "Concrete Pads & Commercial Work",
    "lead": "Concrete beyond residential hardscapes",
    "tags": ["Commercial concrete"],
    "description": "The crew has shared a concrete pad built for a water tank. Ruiz also describes its scope as residential, commercial, industrial and custom work.",
    "bullets": ["Concrete equipment pads", "Commercial flatwork", "Custom project pours"],
    "quoteType": "General Engineering or Public Works",
    "image": "/images/projects/stone-column-detail.jpg",
    "alt": "Ruiz crew placing and finishing concrete at a commercial site",
    "projectUrl": "https://www.instagram.com/ruiz_family_ent/reel/DeAhIfESCuk/"
  },
  {
    "id": "concrete-pumping",
    "tabLabel": "Concrete Pumping",
    "title": "Concrete Pump Service",
    "lead": "Pump equipment on the jobsite",
    "tags": ["Concrete support"],
    "description": "Ruiz lists a 3/8-inch concrete pump service on its website. The crew’s project footage shows pump equipment alongside a custom-home concrete pour.",
    "bullets": ["3/8-inch concrete pump service", "Concrete placement support"],
    "quoteType": "Concrete Pump Service",
    "image": "/images/services/concrete-pump-project.jpg",
    "alt": "Concrete mixer and pump equipment at a Ruiz project site",
    "projectUrl": "https://www.instagram.com/ruiz_family_ent/reel/De91GPKNH2B/"
  }
];
---

<Section id="our-services" variant="light" ariaLabelledby="services-heading">
  <!-- Section Header -->
  <div class="section-header text-center">
    <h2 class="section-title" id="services-heading">
      Explore All Services
    </h2>
    <p class="section-subtitle centered">Concrete, masonry and general engineering for residential, commercial, retail, industrial and custom projects.</p>
  </div>

  <div class="services-directory stack stack--lg" aria-label="All services">
    <div class="grid-4">
      <article class="card-surface stack stack--md">
        <h3>Masonry</h3>
        <ul class="service-list stack stack--sm">
          <li>Block walls</li>
          <li>Retaining walls</li>
          <li>Decorative stone</li>
          <li>Brick work</li>
          <li>Architectural stone</li>
        </ul>
      </article>
      <article class="card-surface stack stack--md">
        <h3>Concrete Construction</h3>
        <ul class="service-list stack stack--sm">
          <li>Concrete patios</li>
          <li>Concrete porches</li>
          <li>Pool decks</li>
          <li>Concrete driveways</li>
          <li>Sidewalks</li>
          <li>Concrete steps</li>
        </ul>
      </article>
      <article class="card-surface stack stack--md">
        <h3>Concrete Finishes &amp; Support</h3>
        <ul class="service-list stack stack--sm">
          <li>Stamped concrete</li>
          <li>Drain and gutter work</li>
          <li>Concrete removal</li>
          <li>3/8-inch concrete pump service</li>
        </ul>
      </article>
      <article class="card-surface stack stack--md">
        <h3>General Engineering &amp; Public Works</h3>
        <ul class="service-list stack stack--sm">
          <li>Concrete flatwork</li>
          <li>Sidewalks, curb and gutter</li>
          <li>Grading and trenching</li>
          <li>Paving and site improvements</li>
        </ul>
      </article>
    </div>
    <p class="services-directory-note">Planning a larger site project? <a href="#engineering-public-works">See general engineering and public works projects</a>, or call <a href="tel:+15592441922">(559) 244-1922</a> to discuss your scope.</p>
  </div>

  <div class="featured-services-intro stack stack--sm">
    <h3>Featured Services</h3>
    <p>Concrete and masonry work shown in Ruiz’s project posts, with service details from the company website.</p>
  </div>

  <!-- Showcase Carousel Container -->
  <div
    class="showcase-carousel-wrapper"
    id="services-carousel"
    role="region"
    aria-roledescription="carousel"
    aria-label="Concrete & Masonry Services"
  >
    <!-- Top Bar: Underline Tabs + Arrow Controls -->
    <div class="showcase-controls-bar">
      <!-- Clean Architectural Underline Tabs (No pills, no numbers) -->
      <nav class="showcase-tablist" role="tablist" aria-label="Trade Capabilities">
        {services.map((service, index) => (
          <button
            type="button"
            role="tab"
            class={`showcase-tab-btn ${index === 0 ? 'is-active' : ''}`}
            id={`service-tab-${index}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`service-slide-${index}`}
            tabindex={index === 0 ? 0 : -1}
            data-slide-index={index}
          >
            {service.tabLabel}
          </button>
        ))}
      </nav>

      <!-- Desktop Arrow Controls (No number counters) -->
      <div class="carousel-btn-group" aria-label="Slide controls">
        <button
          type="button"
          class="carousel-nav-btn prev-btn"
          id="services-carousel-prev"
          aria-label="Previous service"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button
          type="button"
          class="carousel-nav-btn next-btn"
          id="services-carousel-next"
          aria-label="Next service"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <!-- Carousel Slides Track (Native Scroll Snap, Identical Card Sizes) -->
    <div
      class="showcase-track"
      id="services-carousel-track"
      tabindex="0"
      aria-label="Service slides scroller. Use left and right arrow keys to navigate."
    >
      {services.map((service, index) => (
        <article
          class="showcase-slide"
          id={`service-slide-${index}`}
          role="tabpanel"
          aria-labelledby={`service-tab-${index}`}
          aria-roledescription="slide"
          aria-label={`${service.title}`}
          data-slide-index={index}
        >
          <div class="slide-card-container">
            <!-- Left media stage -->
            <figure class="slide-media-stage">
              <img
                src={service.image}
                alt={service.alt}
                class="slide-img"
                width="840"
                height="560"
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
              />
            </figure>

            <!-- Right Editorial Content Card -->
            <div class="slide-content-stage">
              <div class="slide-content-top">
                <!-- Typographic Metadata Line (No pill boxes) -->
                <p class="slide-tags-line">
                  {service.tags.join(' · ')}
                </p>

                <div class="stack stack--sm">
                  <h3 class="slide-title">{service.title}</h3>
                  <span class="slide-lead">{service.lead}</span>
                </div>

                <p class="slide-desc">{service.description}</p>
                <a class="slide-project-link" href={service.projectUrl} target="_blank" rel="noopener noreferrer">View a related project on Instagram <span aria-hidden="true">&rarr;</span></a>
              </div>

              <!-- Craftsmanship Checklist -->
              <div class="slide-checklist-block">
                <h4 class="checklist-heading">Related services</h4>
                <ul class="slide-checklist" aria-label={`Available services for ${service.title}`}>
                  {service.bullets.map(bullet => (
                    <li class="checklist-item">
                      <svg class="check-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Action Row -->
              <div class="slide-actions-row">
                <a
                  href="#quote-builder"
                  class="btn btn-primary slide-cta-btn"
                  data-quote-type={service.quoteType}
                >
                  <span>Discuss This Service</span>
                  <span aria-hidden="true">&rarr;</span>
                </a>
                <a href="tel:+15592441922" class="slide-call-link" aria-label="Call 559-244-1922">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01l-2.2 2.2z"/>
                  </svg>
                  <span>(559) 244-1922</span>
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Reassurance Banner -->
    <div class="services-callout-strip">
      <div class="callout-icon-col">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
      </div>
      <div class="callout-text-col">
        <h3 class="callout-heading">Bring us the idea. We’ll talk through the build.</h3>
        <p class="callout-p">We can discuss the scope, budget and next steps for your concrete or masonry project.</p>
      </div>
      <div class="callout-btn-col">
        <a href="#quote-builder" class="btn btn-outline-dark">
          <span>Discuss Your Project</span>
        </a>
      </div>
    </div>
  </div>
</Section>

<style>
  .services-directory h3 { font-family: var(--font-display); color: var(--text-dark); font-size: 1.15rem; }
  .services-directory p, .service-list { color: var(--text-dark-secondary); }
  .service-list { padding-left: var(--space-5); line-height: 1.5; }
  .services-directory-note a { color: var(--ruiz-blue); text-decoration: underline; text-underline-offset: var(--space-1); }
  .featured-services-intro { margin-top: var(--space-16); margin-bottom: var(--space-6); }
  .featured-services-intro h3 { font-family: var(--font-display); color: var(--text-dark); font-size: clamp(1.5rem, 2.5vw, 2rem); }
  .featured-services-intro p { color: var(--text-dark-secondary); }

  /* ==========================================================================
     SHOWCASE CAROUSEL STYLES
     Architectural Underline Tabs & Identical Uniform Card Heights
     ========================================================================== */

  .showcase-carousel-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Top Bar with Underline Tabs and Controls */
  .showcase-controls-bar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    border-bottom: 1.5px solid var(--border-light);
  }

  /* Clean Architectural Underline Tablist */
  .showcase-tablist {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    max-width: 100%;
    margin-bottom: -1.5px; /* Overlap active border */
  }

  .showcase-tablist::-webkit-scrollbar {
    display: none;
  }

  .showcase-tab-btn {
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    padding: var(--space-3) 0;
    color: var(--text-dark-muted);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .showcase-tab-btn:hover {
    color: var(--ruiz-blue);
  }

  .showcase-tab-btn.is-active {
    color: var(--ruiz-blue);
    font-weight: 700;
    border-bottom-color: transparent;
  }

  /* Arrow Buttons */
  .carousel-btn-group {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
    flex-shrink: 0;
  }

  .carousel-nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    background-color: var(--bg-white);
    border: 1.5px solid var(--border-light);
    color: var(--text-dark);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .carousel-nav-btn:hover {
    background-color: var(--ruiz-blue);
    border-color: var(--ruiz-blue);
    color: #ffffff;
    box-shadow: var(--shadow-sm);
  }

  /* Carousel Track (Native Scroll Snap) */
  .showcase-track {
    display: flex;
    align-items: stretch;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    border-radius: var(--radius-md);
    outline: none;
    gap: 0;
    width: 100%;
  }

  .showcase-track::-webkit-scrollbar {
    display: none;
  }

  .showcase-track:focus-visible {
    box-shadow: 0 0 0 3px var(--ruiz-blue);
  }

  /* Individual Slide: Strict 100% Flex & Equal Height */
  .showcase-slide {
    flex: 0 0 100%;
    min-width: 100%;
    max-width: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
  }

  /* Slide Card Container: Exactly Identical Size Across All Slides */
  .slide-card-container {
    width: 100%;
    background-color: var(--bg-white);
    border: 1.5px solid var(--border-light);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 960px) {
    .slide-card-container {
      grid-template-columns: 1.15fr 1fr;
      height: 560px; /* Strictly equal fixed height on desktop */
    }
  }

  /* Media Stage: Clean Photo with Editorial Bottom Caption */
  .slide-media-stage {
    position: relative;
    height: 280px;
    margin: 0;
    background-color: var(--bg-dark-deep);
    overflow: hidden;
  }

  @media (min-width: 960px) {
    .slide-media-stage {
      height: 100%;
    }
  }

  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-out);
  }

  .slide-card-container:hover .slide-img {
    transform: scale(1.02);
  }

  /* Clean Photographic Bottom Caption Bar (No pills) */
  .slide-photo-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-4) var(--space-4) var(--space-3);
    background: linear-gradient(to top, rgba(15, 23, 42, 0.85) 0%, transparent 100%);
    color: #ffffff;
    font-size: 0.86rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.01em;
  }

  /* Content Stage */
  .slide-content-stage {
    padding: var(--space-card-p);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    gap: var(--space-4);
  }

  .slide-content-top {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* Clean Typographic Tags Line (No pills) */
  .slide-tags-line {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ruiz-terracotta-dark);
    margin-bottom: var(--space-1);
  }

  .slide-title {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.2vw, 1.65rem);
    font-weight: 800;
    line-height: 1.22;
    color: var(--text-dark);
  }

  .slide-lead {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ruiz-blue);
  }

  .slide-desc {
    font-size: 0.92rem;
    color: var(--text-dark-secondary);
    line-height: 1.55;
    margin-top: var(--space-1);
  }

  .slide-project-link {
    align-self: flex-start;
    color: var(--ruiz-blue);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: var(--space-1);
  }

  /* Checklist Block */
  .slide-checklist-block {
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-light);
  }

  .checklist-heading {
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-dark-muted);
    margin-bottom: var(--space-2);
  }

  .slide-checklist {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .checklist-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: 0.9rem;
    color: var(--text-dark-secondary);
    line-height: 1.4;
  }

  .check-icon {
    color: var(--ruiz-blue);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  /* Actions Row */
  .slide-actions-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-light);
  }

  .slide-cta-btn {
    font-size: 0.92rem;
    border-radius: var(--radius-md);
  }

  .slide-call-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-dark-secondary);
    text-decoration: none;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast);
  }

  .slide-call-link:hover {
    color: var(--ruiz-blue);
  }

  /* Reassurance Banner */
  .services-callout-strip {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    background: var(--bg-white);
    border: 1.5px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-card-p);
    box-shadow: var(--shadow-sm);
  }

  .callout-icon-col {
    color: var(--ruiz-blue);
    flex-shrink: 0;
  }

  .callout-text-col {
    flex: 1;
    min-width: 260px;
  }

  .callout-heading {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: var(--space-1);
  }

  .callout-p {
    font-size: 0.92rem;
    color: var(--text-dark-secondary);
    line-height: 1.55;
    max-width: 70ch;
  }

  .callout-btn-col {
    flex-shrink: 0;
  }

  /* Motion Preferences */
  @media (prefers-reduced-motion: reduce) {
    .showcase-track {
      scroll-behavior: auto;
    }
    .slide-img {
      transition: none !important;
    }
    .showcase-tab-btn,
    .carousel-nav-btn {
      transition: none !important;
    }
  }
</style>

<script>
  // Ruiz Family Enterprises - Showcase Carousel Controller
  function initServicesCarousel() {
    const track = document.getElementById('services-carousel-track') as HTMLElement | null;
    const prevBtn = document.getElementById('services-carousel-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('services-carousel-next') as HTMLButtonElement | null;
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.showcase-tab-btn');
    const slides = document.querySelectorAll<HTMLElement>('.showcase-slide');
    const ctaLinks = document.querySelectorAll<HTMLAnchorElement>('.slide-cta-btn');

    if (!track || slides.length === 0) return;

    const tablist = document.querySelector<HTMLElement>('.showcase-tablist');
    let activeIndex = 0;
    let isInitialLoad = true;
    const totalSlides = slides.length;

    function scrollTabIntoTablist(tab: HTMLElement) {
      if (!tablist || tablist.scrollWidth <= tablist.clientWidth) return;

      const tabLeft = tab.offsetLeft;
      const tabRight = tabLeft + tab.offsetWidth;
      const listScrollLeft = tablist.scrollLeft;
      const listWidth = tablist.clientWidth;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const behavior = prefersReducedMotion ? 'auto' : 'smooth';

      if (tabLeft < listScrollLeft) {
        tablist.scrollTo({ left: tabLeft, behavior });
      } else if (tabRight > listScrollLeft + listWidth) {
        tablist.scrollTo({ left: tabRight - listWidth, behavior });
      }
    }

    function scrollToSlide(index: number) {
      if (index < 0) index = totalSlides - 1;
      if (index >= totalSlides) index = 0;

      const targetSlide = slides[index];
      if (!targetSlide) return;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      track.scrollTo({
        left: targetSlide.offsetLeft,
        behavior: prefersReducedMotion ? 'auto' : 'smooth'
      });
    }

    function updateActiveState(index: number) {
      activeIndex = index;
      slides.forEach((slide, i) => slide.classList.toggle('is-current', i === index));

      // Update Tabs
      tabBtns.forEach((tab, i) => {
        const isSelected = i === index;
        tab.classList.toggle('is-active', isSelected);
        tab.setAttribute('aria-selected', isSelected ? 'true' : 'false');
        tab.setAttribute('tabindex', isSelected ? '0' : '-1');

        if (isSelected && !isInitialLoad) {
          scrollTabIntoTablist(tab);
        }
      });

      isInitialLoad = false;
    }

    // Tab Button Click
    tabBtns.forEach((tab) => {
      tab.addEventListener('click', () => {
        const index = parseInt(tab.getAttribute('data-slide-index') || '0', 10);
        scrollToSlide(index);
      });
    });

    // Arrow Buttons
    prevBtn?.addEventListener('click', () => {
      scrollToSlide(activeIndex - 1);
    });

    nextBtn?.addEventListener('click', () => {
      scrollToSlide(activeIndex + 1);
    });

    // Keyboard Navigation
    track.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        scrollToSlide(activeIndex - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        scrollToSlide(activeIndex + 1);
      }
    });

    // IntersectionObserver to sync active tab on scroll / swipe
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
            const index = parseInt(entry.target.getAttribute('data-slide-index') || '0', 10);
            updateActiveState(index);
          }
        });
      },
      {
        root: track,
        threshold: 0.5
      }
    );

    slides.forEach((slide) => observer.observe(slide));

    // Connect Quote CTAs to QuoteBuilder form
    ctaLinks.forEach((cta) => {
      cta.addEventListener('click', () => {
        const quoteType = cta.getAttribute('data-quote-type');
        if (!quoteType) return;

        const radio = document.querySelector<HTMLInputElement>(`input[name="projectType"][value="${quoteType}"]`);
        if (radio) {
          radio.checked = true;
          document.querySelectorAll<HTMLLabelElement>('.type-pill').forEach(pill => {
            pill.classList.remove('is-selected');
          });
          const parentLabel = radio.closest<HTMLLabelElement>('.type-pill');
          if (parentLabel) {
            parentLabel.classList.add('is-selected');
          }
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initServicesCarousel);
  } else {
    initServicesCarousel();
  }

  document.addEventListener('astro:page-load', initServicesCarousel);
</script>
