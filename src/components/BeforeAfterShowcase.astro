<style>
  /* ==========================================================================
     WHAT IT LOOKS LIKE TO WORK WITH RUIZ
     Open Editorial Video Showcase (No carousels, no tabs, no pills, no status lights)
     ========================================================================== */

  .jobsite-showcase {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* --------------------------------------------------------------------------
     1. Lead Spotlight Feature (2-Column Grid)
     -------------------------------------------------------------------------- */
  .jobsite-hero-feature {
    display: grid;
    grid-template-columns: 1fr;
    background-color: var(--bg-white);
    border: 1.5px solid var(--border-light);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  @media (min-width: 960px) {
    .jobsite-hero-feature {
      grid-template-columns: 1.15fr 1fr;
      min-height: 520px;
    }
  }

  .hero-video-box {
    position: relative;
    background-color: #000000;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  @media (min-width: 960px) {
    .hero-video-box {
      aspect-ratio: auto;
      height: 100%;
    }
  }

  .jobsite-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background-color: #000000;
  }

  /* Video Caption Overlay */
  .video-caption-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-3) var(--space-4);
    padding-right: 4.5rem;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.9) 0%, transparent 100%);
    color: #ffffff;
    font-size: 0.84rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    pointer-events: none;
    z-index: 2;
  }

  .caption-location {
    color: var(--ruiz-sandstone-light);
    font-weight: 700;
  }

  .caption-sep {
    opacity: 0.5;
  }

  .caption-action {
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Play / Pause Toggle Button */
  .video-play-btn {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    width: 34px;
    height: 34px;
    border-radius: var(--radius-md);
    background-color: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition: background-color var(--transition-fast), transform var(--transition-fast);
    z-index: 3;
  }

  .video-play-btn:hover {
    background-color: var(--ruiz-blue);
    transform: scale(1.06);
  }

  /* Hero Feature Right Column */
  .hero-feature-content {
    padding: var(--space-card-p);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
    background-color: var(--bg-light);
  }

  .feature-tag-line {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ruiz-terracotta-dark);
  }

  .hero-feature-title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.2vw, 1.85rem);
    font-weight: 800;
    line-height: 1.22;
    color: var(--text-dark);
  }

  .hero-feature-copy {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-dark-secondary);
  }

  /* 3 Guarantees List */
  .feature-guarantees-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background-color: var(--bg-white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .guarantee-row {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .guarantee-row:not(:last-child) {
    padding-bottom: var(--space-3);
