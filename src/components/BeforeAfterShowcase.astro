    justify-content: space-between;
    flex-grow: 1;
    gap: var(--space-3);
    background-color: var(--bg-light);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.18rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--text-dark);
  }

  .card-description {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-dark-secondary);
    margin: 0;
  }

  /* Card Details Row */
  .card-details-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
    background-color: var(--bg-white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    margin-top: auto;
  }

  .detail-cell {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .detail-label {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-dark-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .detail-val {
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--text-dark);
    line-height: 1.3;
  }

  /* --------------------------------------------------------------------------
     3. Bottom Standards Strip (Strict Equal Heights, No Numbers)
     -------------------------------------------------------------------------- */
  .jobsite-standards-strip {
    margin-top: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1.5px solid var(--border-light);
  }

  .standards-header {
    margin-bottom: var(--space-6);
  }

  .standards-title {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: var(--space-1);
  }

  .standards-subtitle {
    font-size: 0.95rem;
    color: var(--text-dark-muted);
  }

  .standards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .standards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .standards-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .standard-card {
    background-color: var(--bg-light);
    border: 1.5px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .standard-card:hover {
    transform: translateY(-2px);
    border-color: var(--ruiz-blue);
  }

  .standard-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.3;
  }

  .standard-copy {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-dark-secondary);
    margin: 0;
  }

  /* Motion Preferences */
  @media (prefers-reduced-motion: reduce) {
    .jobsite-video-card,
    .standard-card,
    .video-play-btn {
      transition: none !important;
    }
  }
</style>

<script>
  // Simple Video Play/Pause Controllers
  function initJobsiteVideos() {
    const videoContainers = document.querySelectorAll<HTMLElement>('.hero-video-box, .card-video-box');

    videoContainers.forEach(box => {
      const video = box.querySelector<HTMLVideoElement>('[data-jobsite-video]');
      const toggle = box.querySelector<HTMLButtonElement>('[data-video-toggle]');
      const iconPlay = toggle?.querySelector<SVGElement>('.icon-play');
      const iconPause = toggle?.querySelector<SVGElement>('.icon-pause');

      if (!video || !toggle) return;

      // Handle prefers-reduced-motion
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        video.pause();
        if (iconPlay && iconPause) {
          iconPlay.hidden = false;
          iconPause.hidden = true;
        }
      }

      function updateIcons(isPaused: boolean) {
        if (iconPlay && iconPause) {
          iconPlay.hidden = !isPaused;
          iconPause.hidden = isPaused;
        }
        toggle?.setAttribute('aria-label', isPaused ? 'Play video' : 'Pause video');
      }

      toggle.addEventListener('click', () => {
        if (video.paused) {
          video.play();
          updateIcons(false);
        } else {
          video.pause();
          updateIcons(true);
        }
      });

      video.addEventListener('play', () => updateIcons(false));
      video.addEventListener('pause', () => updateIcons(true));
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initJobsiteVideos);
  } else {
    initJobsiteVideos();
  }

  document.addEventListener('astro:page-load', initJobsiteVideos);
</script>
