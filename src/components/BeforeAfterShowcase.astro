---
// Ruiz Family Enterprises - "What It Looks Like to Work With Ruiz" Section
// Clean, Open Video Documentary Showcase (CSLB #1055499)
// No carousels, no tabs, no pill badges, no status lights, no sequence numbers.
import Section from './Section.astro';

const jobsiteVideos = [
  {
    id: "narrow-line-pump",
    title: "Pumping Setup",
    videoMp4: "/videos/work-line-pump-dawn.mp4",
    videoWebm: "/videos/work-line-pump-dawn.webm",
    poster: "/images/posters/work-line-pump-dawn.jpg"
  },
  {
    id: "laser-excavation",
    title: "Site Preparation",
    videoMp4: "/videos/work-bobcat-grading.mp4",
    videoWebm: "/videos/work-bobcat-grading.webm",
    poster: "/images/posters/work-bobcat-grading.jpg"
  },
  {
    id: "hand-finishing",
    title: "Concrete Finishing",
    videoMp4: "/videos/work-hand-screeding.mp4",
    videoWebm: "/videos/work-hand-screeding.webm",
    poster: "/images/posters/work-hand-screeding.jpg"
  },
  {
    id: "commercial-drone",
    title: "Project Overview",
    videoMp4: "/videos/work-aerial-drone.mp4",
    videoWebm: "/videos/work-aerial-drone.webm",
    poster: "/images/posters/work-aerial-drone.jpg"
  }
];

---

<Section id="our-work" variant="white" ariaLabelledby="experience-heading">
  <!-- Section Header: Clear, Authoritative, Direct -->
  <div class="section-header text-center">
    <h2 class="section-title" id="experience-heading">
      Concrete Craftsmanship, Up Close.
    </h2>
  </div>

  <div class="jobsite-showcase">
    <!-- Lead jobsite footage -->
    <div class="jobsite-hero-feature">
      <div class="hero-video-box">
        <video
          class="jobsite-video"
          loop
          muted
          playsinline
          preload="none"
          poster="/images/posters/work-luxury-pour.jpg"
          data-jobsite-video
          aria-label="Concrete work in progress"
        >
          <source data-src="/videos/work-luxury-pour.webm" type="video/webm" />
          <source data-src="/videos/work-luxury-pour.mp4" type="video/mp4" />
          <p>Your browser does not support HTML5 video.</p>
        </video>

        <button
          type="button"
          class="video-play-btn"
          data-video-toggle
          aria-label="Play video: Concrete work in progress"
        >
          <svg class="icon-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" hidden aria-hidden="true">
            <rect x="6" y="4" width="4" height="16"></rect>
            <rect x="14" y="4" width="4" height="16"></rect>
          </svg>
          <svg class="icon-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
        </button>
      </div>
    </div>

    <!-- Open Operations Video Grid: All 4 Videos Visible Together (No Carousels) -->
    <div class="jobsite-cards-grid">
      {jobsiteVideos.map((item) => (
        <div class="jobsite-video-card">
          <div class="card-video-box">
            <video
              class="jobsite-video"
              loop
              muted
              playsinline
              preload="none"
              poster={item.poster}
              data-jobsite-video
              aria-label={`${item.title} on-site footage`}
            >
              <source data-src={item.videoWebm} type="video/webm" />
              <source data-src={item.videoMp4} type="video/mp4" />
              <p>Your browser does not support HTML5 video.</p>
            </video>

            <button
              type="button"
              class="video-play-btn"
              data-video-toggle
              aria-label={`Play video: ${item.title} on-site footage`}
            >
              <svg class="icon-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" hidden aria-hidden="true">
                <rect x="6" y="4" width="4" height="16"></rect>
                <rect x="14" y="4" width="4" height="16"></rect>
              </svg>
              <svg class="icon-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
            </button>
          </div>
        </div>
      ))}
    </div>

  </div>
</Section>

<style>
  /* ==========================================================================
     WHAT IT LOOKS LIKE TO WORK WITH RUIZ
     Open Editorial Video Showcase (No carousels, no tabs, no pills, no status lights)
     ========================================================================== */

  .jobsite-showcase {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .jobsite-hero-feature {
    background-color: var(--bg-white);
    border: 1.5px solid var(--border-light);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .hero-video-box {
    position: relative;
    background-color: #000000;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .jobsite-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background-color: #000000;
  }

  /* Play / Pause Toggle Button */
  .video-play-btn {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    width: 34px;
    height: 34px;
    border-radius: var(--radius-md);
    background-color: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition: background-color var(--transition-fast), transform var(--transition-fast);
    z-index: 3;
  }

  .video-play-btn [hidden] { display: none; }

  .video-play-btn:hover {
    background-color: var(--ruiz-blue);
    transform: scale(1.06);
  }

  /* --------------------------------------------------------------------------
     2. Open Operations Video Grid (All 4 Videos Visible Together)
     -------------------------------------------------------------------------- */
  .jobsite-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .jobsite-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .jobsite-video-card {
    background-color: var(--bg-white);
    border: 1.5px solid var(--border-light);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .jobsite-video-card:hover {
    border-color: var(--ruiz-blue);
    transform: translateY(-2px);
  }

  .card-video-box {
    position: relative;
    background-color: #000000;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  /* Motion Preferences */
  @media (prefers-reduced-motion: reduce) {
    .jobsite-video-card,
    .video-play-btn {
      transition: none !important;
    }
  }
</style>

<script>
  import { initJobsiteVideo } from '../lib/deferred-media';

  let cleanups: Array<() => void> = [];
  function cleanup() {
    cleanups.forEach(dispose => dispose());
    cleanups = [];
  }
  function init() {
    cleanup();
    document.querySelectorAll<HTMLElement>('.hero-video-box, .card-video-box').forEach(box => {
      cleanups.push(initJobsiteVideo(box));
    });
  }
  init();
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', cleanup);
</script>
