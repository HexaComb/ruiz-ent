---
// Ruiz Family Enterprises - "What It Looks Like to Work With Ruiz" Section
// Clean, Open Video Documentary Showcase (CSLB #1055499)
// No carousels, no tabs, no pill badges, no status lights, no sequence numbers.
import Section from './Section.astro';

const jobsiteVideos = [
  {
    id: "narrow-line-pump",
    title: "Pumping 200+ Feet Through 4-Foot Gates",
    location: "Central Valley Residential",
    operation: "Narrow Gate Access & Property Defense",
    videoMp4: "/videos/work-line-pump-dawn.mp4",
    videoWebm: "/videos/work-line-pump-dawn.webm",
    poster: "/images/posters/work-line-pump-dawn.jpg",
    description: "Before daytime heat sets in, we route rubber line pump hoses through side gates directly to backyards. Heavy 60,000-lb mixer trucks stay on the street—your driveway, grass, and curbs remain untouched.",
    details: [
      { label: "Gate Clearance", val: "4 ft minimum" },
      { label: "Pumping Reach", val: "Up to 250 LF" },
      { label: "Property Impact", val: "Zero heavy ruts" }
    ]
  },
  {
    id: "laser-excavation",
    title: "Surgical Excavation & Laser Drainage",
    location: "Clovis & Kingsburg Estates",
    operation: "Subgrade Earthwork & Transit Slopes",
    videoMp4: "/videos/work-bobcat-grading.mp4",
    videoWebm: "/videos/work-bobcat-grading.webm",
    poster: "/images/posters/work-bobcat-grading.jpg",
    description: "Our compact track loader maneuvers inches away from luxury stucco columns and existing structures. Jose personally shoots optical laser transit elevations to ensure all water drains away from home foundations.",
    details: [
      { label: "Slope Tolerance", val: "1/4\" per foot" },
      { label: "Elevation Check", val: "Digital laser transit" },
      { label: "Sub-Base", val: "Machine-compacted" }
    ]
  },
  {
    id: "hand-finishing",
    title: "Magnesium Floating & Hand-Tooled Borders",
    location: "Fresno County Luxury Build",
    operation: "Artisan Masonry & Surface Textures",
    videoMp4: "/videos/work-hand-screeding.mp4",
    videoWebm: "/videos/work-hand-screeding.webm",
    poster: "/images/posters/work-hand-screeding.jpg",
    description: "Our masons pass dual magnesium bull floats to draw rich cream to the top, hand-tooling smooth radius edges and stress-relief expansion cuts that prevent random surface cracking in California heat.",
    details: [
      { label: "Surface Pass", val: "Dual magnesium floats" },
      { label: "Edge Tooling", val: "Hand-tooled smooth radius" },
      { label: "Joint Pattern", val: "Stress relief on code" }
    ]
  },
  {
    id: "commercial-drone",
    title: "Class A Heavy Engineering & Night Pours",
    location: "Central Valley Commercial Site",
    operation: "Large Foundation & Continuous Pour",
    videoMp4: "/videos/work-aerial-drone.mp4",
    videoWebm: "/videos/work-aerial-drone.webm",
    poster: "/images/posters/work-aerial-drone.jpg",
    description: "For massive multi-thousand-square-foot civic slabs and heavy commercial foundations, continuous mixer truck rotations eliminate cold seams under floodlights with municipal-grade precision.",
    details: [
      { label: "License Class", val: "Class A (#1055499)" },
      { label: "Pour Rotation", val: "Continuous cycle" },
      { label: "Mix Rating", val: "4,000+ PSI certified" }
    ]
  }
];

const standards = [
  {
    title: "Owner On Every Pour",
    desc: "Jose Daniel Ruiz (CSLB #1055499) is physically on your jobsite directing the nozzle, laser grading, and hand float passes. Never outsourced to brokers."
  },
  {
    title: "Zero Lawn Damage",
    desc: "Specialized rubber line pump hoses navigate narrow 4-ft side gates. We never drive 30-ton mixer trucks onto your driveway, curbs, or front landscaping."
  },
  {
    title: "Digital Laser Slopes",
    desc: "Every grade is shot with optical laser transits before forms are set, guaranteeing rainwater drains safely away from home foundations."
  },
  {
    title: "Generational Water Cure",
    desc: "Flooding fresh slabs with multi-day water hydration prevents thermal shrinkage cracks in Central Valley heat and reaches full 4,000+ PSI strength."
  }
];
---

<Section id="our-work" variant="white" ariaLabelledby="experience-heading">
  <!-- Section Header: Clear, Authoritative, Direct -->
  <div class="section-header text-center">
    <h2 class="section-title" id="experience-heading">
      What It Looks Like to Work With Ruiz.
    </h2>
    <p class="section-subtitle centered">
      No sales brokers or absentee contractors. Step directly onto our Central Valley jobsites to see how Jose Daniel Ruiz and our 3rd-generation crew protect your property, grade with laser transits, pump through narrow gates, and hand-finish every yard.
    </p>
  </div>

  <div class="jobsite-showcase">
    <!-- Main Feature: The Live Pour in Action (Widescreen 2-Column Spotlight) -->
    <article class="jobsite-hero-feature">
      <div class="hero-video-box">
        <video
          class="jobsite-video"
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          poster="/images/posters/work-luxury-pour.jpg"
          data-jobsite-video
          aria-label="Jose Daniel Ruiz and crew pouring concrete on-site"
        >
          <source src="/videos/work-luxury-pour.webm" type="video/webm" />
          <source src="/videos/work-luxury-pour.mp4" type="video/mp4" />
          <p>Your browser does not support HTML5 video.</p>
        </video>

        <div class="video-caption-bar">
          <span class="caption-location">Kingsburg Custom Estate</span>
          <span class="caption-sep" aria-hidden="true">·</span>
          <span class="caption-action">The Live Pour &amp; Synchronized Screeding</span>
        </div>

        <button
          type="button"
          class="video-play-btn"
          data-video-toggle
          aria-label="Pause video"
        >
          <svg class="icon-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <rect x="6" y="4" width="4" height="16"></rect>
            <rect x="14" y="4" width="4" height="16"></rect>
          </svg>
          <svg class="icon-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" hidden aria-hidden="true">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
        </button>
      </div>

      <div class="hero-feature-content">
        <div class="feature-tag-line">
          <span>Hands-On Leadership · 3 Generations of Field Grit</span>
        </div>

        <h3 class="hero-feature-title">
          Owner on Every Pour, From Dawn to Water Cure.
        </h3>

        <p class="hero-feature-copy">
          When you hire Ruiz Family Enterprises, you work directly with Jose Daniel Ruiz (CSLB #1055499). We do not dispatch subcontractors or day laborers. Our crew arrives at dawn with our own line pumps and Bobcat equipment, directs slump consistency at the nozzle, and stays on the slab until the final hand-trowel pass and multi-day water cure are completed.
        </p>

        <!-- 3 Core Guarantees -->
        <div class="feature-guarantees-list">
          <div class="guarantee-row">
            <strong class="guarantee-name">Property &amp; Lawn Protection</strong>
            <span class="guarantee-text">Rubber line pump hoses route 200+ feet through 4-foot gates so heavy trucks never touch your lawn or driveway.</span>
          </div>
          <div class="guarantee-row">
            <strong class="guarantee-name">Laser-Calibrated Drainage</strong>
            <span class="guarantee-text">Jose personally verifies every grade with an optical laser transit to guarantee water pitches away from home foundations.</span>
          </div>
          <div class="guarantee-row">
            <strong class="guarantee-name">Generational Water Curing</strong>
            <span class="guarantee-text">We flood slabs with water for multiple days to prevent thermal shrinkage cracks in Central Valley heat and lock in 4,000+ PSI strength.</span>
          </div>
        </div>

        <div class="hero-feature-actions">
          <a href="#quote-builder" class="btn btn-primary">
            <span>Schedule Jobsite Walkthrough</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a href="tel:+15592441922" class="direct-phone-call">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01l-2.2 2.2z"/>
            </svg>
            <span>Speak With Jose: (559) 244-1922</span>
          </a>
        </div>
      </div>
    </article>

    <!-- Open Operations Video Grid: All 4 Videos Visible Together (No Carousels) -->
    <div class="jobsite-cards-grid">
      {jobsiteVideos.map((item) => (
        <article class="jobsite-video-card">
          <div class="card-video-box">
            <video
              class="jobsite-video"
              autoplay
              loop
              muted
              playsinline
              preload="metadata"
              poster={item.poster}
              data-jobsite-video
              aria-label={`${item.title} on-site footage`}
            >
              <source src={item.videoWebm} type="video/webm" />
              <source src={item.videoMp4} type="video/mp4" />
              <p>Your browser does not support HTML5 video.</p>
            </video>

            <div class="video-caption-bar">
              <span class="caption-location">{item.location}</span>
              <span class="caption-sep" aria-hidden="true">·</span>
              <span class="caption-action">{item.operation}</span>
            </div>

            <button
              type="button"
              class="video-play-btn"
              data-video-toggle
              aria-label={`Pause video for ${item.title}`}
            >
              <svg class="icon-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <rect x="6" y="4" width="4" height="16"></rect>
                <rect x="14" y="4" width="4" height="16"></rect>
              </svg>
              <svg class="icon-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" hidden aria-hidden="true">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
            </button>
          </div>

          <div class="card-text-box">
            <h4 class="card-title">{item.title}</h4>
            <p class="card-description">{item.description}</p>

            <div class="card-details-row">
              {item.details.map((d) => (
                <div class="detail-cell">
                  <span class="detail-label">{d.label}</span>
                  <span class="detail-val">{d.val}</span>
                </div>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- The 4 Pillars of Working with Ruiz (Bottom Standards Strip) -->
    <div class="jobsite-standards-strip">
      <div class="standards-header text-center">
        <h3 class="standards-title">The Ruiz Working Standard on Every Property</h3>
        <p class="standards-subtitle">Every build adheres to three generations of Central Valley field protocol. No shortcuts.</p>
      </div>

      <div class="standards-grid">
        {standards.map((s) => (
          <div class="standard-card">
            <h4 class="standard-title">{s.title}</h4>
            <p class="standard-copy">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</Section>

<style>
  /* ==========================================================================
     WHAT IT LOOKS LIKE TO WORK WITH RUIZ
     Open Editorial Video Showcase (No carousels, no tabs, no pills, no status lights)
     ========================================================================== */

  .jobsite-showcase {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* --------------------------------------------------------------------------
     1. Lead Spotlight Feature (2-Column Grid)
     -------------------------------------------------------------------------- */
  .jobsite-hero-feature {
    display: grid;
    grid-template-columns: 1fr;
    background-color: var(--bg-white);
    border: 1.5px solid var(--border-light);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  @media (min-width: 960px) {
    .jobsite-hero-feature {
      grid-template-columns: 1.15fr 1fr;
      min-height: 520px;
    }
  }

  .hero-video-box {
    position: relative;
    background-color: #000000;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  @media (min-width: 960px) {
    .hero-video-box {
      aspect-ratio: auto;
      height: 100%;
    }
  }

  .jobsite-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background-color: #000000;
  }

  /* Video Caption Overlay */
  .video-caption-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-3) var(--space-4);
    padding-right: 4.5rem;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.9) 0%, transparent 100%);
    color: #ffffff;
    font-size: 0.84rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    pointer-events: none;
    z-index: 2;
  }

  .caption-location {
    color: var(--ruiz-sandstone-light);
    font-weight: 700;
  }

  .caption-sep {
    opacity: 0.5;
  }

  .caption-action {
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Play / Pause Toggle Button */
  .video-play-btn {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-3);
    width: 34px;
    height: 34px;
    border-radius: var(--radius-md);
    background-color: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition: background-color var(--transition-fast), transform var(--transition-fast);
    z-index: 3;
  }

  .video-play-btn:hover {
    background-color: var(--ruiz-blue);
    transform: scale(1.06);
  }

  /* Hero Feature Right Column */
  .hero-feature-content {
    padding: var(--space-card-p);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
    background-color: var(--bg-light);
  }

  .feature-tag-line {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ruiz-terracotta-dark);
  }

  .hero-feature-title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.2vw, 1.85rem);
    font-weight: 800;
    line-height: 1.22;
    color: var(--text-dark);
  }

  .hero-feature-copy {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-dark-secondary);
  }

  /* 3 Guarantees List */
  .feature-guarantees-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background-color: var(--bg-white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }

  .guarantee-row {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .guarantee-row:not(:last-child) {
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-light);
  }

  .guarantee-name {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-dark);
  }

  .guarantee-text {
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--text-dark-secondary);
  }

  /* Actions */
  .hero-feature-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-top: var(--space-2);
    border-top: 1px solid var(--border-light);
  }

  .direct-phone-call {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-dark-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .direct-phone-call:hover {
    color: var(--ruiz-blue);
  }

  /* --------------------------------------------------------------------------
     2. Open Operations Video Grid (All 4 Videos Visible Together)
     -------------------------------------------------------------------------- */
  .jobsite-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .jobsite-cards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .jobsite-video-card {
    background-color: var(--bg-white);
    border: 1.5px solid var(--border-light);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .jobsite-video-card:hover {
    border-color: var(--ruiz-blue);
    transform: translateY(-2px);
  }

  .card-video-box {
    position: relative;
    background-color: #000000;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .card-text-box {
    padding: var(--space-card-p);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-grow: 1;
    gap: var(--space-3);
    background-color: var(--bg-light);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: 1.18rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--text-dark);
  }

  .card-description {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--text-dark-secondary);
    margin: 0;
  }

  /* Card Details Row */
  .card-details-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
    background-color: var(--bg-white);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    margin-top: auto;
  }

  .detail-cell {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .detail-label {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-dark-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .detail-val {
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--text-dark);
    line-height: 1.3;
  }

  /* --------------------------------------------------------------------------
     3. Bottom Standards Strip (Strict Equal Heights, No Numbers)
     -------------------------------------------------------------------------- */
  .jobsite-standards-strip {
    margin-top: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1.5px solid var(--border-light);
  }

  .standards-header {
    margin-bottom: var(--space-6);
  }

  .standards-title {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    font-weight: 800;
    color: var(--text-dark);
    margin-bottom: var(--space-1);
  }

  .standards-subtitle {
    font-size: 0.95rem;
    color: var(--text-dark-muted);
  }

  .standards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .standards-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .standards-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .standard-card {
    background-color: var(--bg-light);
    border: 1.5px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .standard-card:hover {
    transform: translateY(-2px);
    border-color: var(--ruiz-blue);
  }

  .standard-title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-dark);
    line-height: 1.3;
  }

  .standard-copy {
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--text-dark-secondary);
    margin: 0;
  }

  /* Motion Preferences */
  @media (prefers-reduced-motion: reduce) {
    .jobsite-video-card,
    .standard-card,
    .video-play-btn {
      transition: none !important;
    }
  }
</style>

<script>
  // Simple Video Play/Pause Controllers
  function initJobsiteVideos() {
    const videoContainers = document.querySelectorAll<HTMLElement>('.hero-video-box, .card-video-box');

    videoContainers.forEach(box => {
      const video = box.querySelector<HTMLVideoElement>('[data-jobsite-video]');
      const toggle = box.querySelector<HTMLButtonElement>('[data-video-toggle]');
      const iconPlay = toggle?.querySelector<SVGElement>('.icon-play');
      const iconPause = toggle?.querySelector<SVGElement>('.icon-pause');

      if (!video || !toggle) return;

      // Handle prefers-reduced-motion
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        video.pause();
        if (iconPlay && iconPause) {
          iconPlay.hidden = false;
          iconPause.hidden = true;
        }
      }

      function updateIcons(isPaused: boolean) {
        if (iconPlay && iconPause) {
          iconPlay.hidden = !isPaused;
          iconPause.hidden = isPaused;
        }
        toggle?.setAttribute('aria-label', isPaused ? 'Play video' : 'Pause video');
      }

      toggle.addEventListener('click', () => {
        if (video.paused) {
          video.play();
          updateIcons(false);
        } else {
          video.pause();
          updateIcons(true);
        }
      });

      video.addEventListener('play', () => updateIcons(false));
      video.addEventListener('pause', () => updateIcons(true));
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initJobsiteVideos);
  } else {
    initJobsiteVideos();
  }

  document.addEventListener('astro:page-load', initJobsiteVideos);
</script>
