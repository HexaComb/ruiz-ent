  /* --------------------------------------------------------------------------
     2. Open Operations Video Grid (All 4 Videos Visible Together)
     -------------------------------------------------------------------------- */
  .jobsite-cards-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
