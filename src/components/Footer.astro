---
// Ruiz Family Enterprises - Site Footer Component
---

<!-- Ruiz 4-Color Signature Spectrum Bar -->
<div class="spectrum-bar" aria-hidden="true">
  <span></span>
  <span></span>
  <span></span>
  <span></span>
</div>

<!-- Site Footer -->
<footer class="site-footer" id="contact">
  <div class="container">
    <div class="footer-top">
      <!-- Brand & Mission Column -->
      <div class="footer-brand-col">
        <a href="/" class="footer-logo-link" aria-label="Ruiz Family Enterprises Home">
          <img
            src="/images/brand/ruiz-family-logo-web.png"
            alt="Ruiz Family Enterprises Inc"
            class="footer-logo-img"
            width="60"
            height="48"
            loading="lazy"
          />
          <div class="footer-brand-text">
            <span class="brand-title">Ruiz Family Enterprises</span>
            <span class="brand-sub">Generations of Craftsmanship &bull; Lic #1055499</span>
          </div>
        </a>

        <p class="footer-mission-p">
          Setting the standard of quality for three generations. General Engineering (A), Concrete (C-8), and Masonry (C-29) contractor delivering luxury custom homes, commercial flatwork, and structural block walls across the Central Valley.
        </p>

        <div class="footer-social-row">
          <a
            href="https://www.instagram.com/ruiz_family_ent/"
            target="_blank"
            rel="noopener noreferrer"
            class="social-btn"
            aria-label="Follow Ruiz Family Enterprises on Instagram"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>

          <a
            href="https://www.youtube.com/@RuizFamilyEnterprisesInc"
            target="_blank"
            rel="noopener noreferrer"
            class="social-btn"
            aria-label="Subscribe to Ruiz Family Enterprises on YouTube"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Quick Nav Links -->
      <div class="footer-nav-col">
        <h4 class="col-heading">Navigation</h4>
        <nav class="footer-nav-list" aria-label="Footer Navigation">
          <a href="#hero">Home</a>
          <a href="#our-services">Services &amp; Disciplines</a>
          <a href="#our-work">Before &amp; After Showcase</a>
          <a href="#our-story">The Ruiz Family Story</a>
          <a href="#our-process">The 4-Step Build Process</a>
          <a href="#field-reels">Field Reels &amp; Realness</a>
          <a href="#reviews">Verified Client Reviews</a>
          <a href="#faq">Frequently Asked Questions</a>
          <a href="#quote-builder">Request Free Estimate</a>
        </nav>
      </div>

      <!-- Services Directory -->
      <div class="footer-services-col">
        <h4 class="col-heading">Core Hardscapes</h4>
        <ul class="footer-links-list">
          <li><a href="#our-services">Decorative Stamped Concrete</a></li>
          <li><a href="#our-services">Luxury Pool Decks &amp; Coping</a></li>
          <li><a href="#our-services">Split-Face Block Privacy Walls</a></li>
          <li><a href="#our-services">Structural Retaining Walls</a></li>
          <li><a href="#our-services">Dry-Stacked Architectural Stone</a></li>
          <li><a href="#our-services">Backyard Firepits &amp; BBQ Pads</a></li>
          <li><a href="#our-services">3/8" Concrete Line Pump Service</a></li>
          <li><a href="#our-services">Concrete Breakout &amp; Haul Away</a></li>
        </ul>
      </div>

      <!-- Contact Info & Hours -->
      <div class="footer-contact-col">
        <h4 class="col-heading">Contact the Family</h4>
        <div class="contact-items-stack">
          <div class="c-item">
            <span class="c-label">Direct Phone:</span>
            <a href="tel:+15592441922" class="c-value phone-link">(559) 244-1922</a>
          </div>

          <div class="c-item">
            <span class="c-label">Official Email:</span>
            <a href="mailto:ruizfamilyent@gmail.com" class="c-value">ruizfamilyent@gmail.com</a>
          </div>

          <div class="c-item">
            <span class="c-label">Headquarters:</span>
            <span class="c-value">Kingsburg, CA 93631</span>
          </div>

          <div class="c-item">
            <span class="c-label">California License:</span>
            <span class="c-value license-val">CSLB #1055499 (A, C-8, C-29)</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer Bottom Strip -->
    <div class="footer-bottom">
      <p class="footer-seo-line">
        Decorative Stamped Concrete &bull; Luxury Pool Decks &bull; Split-Face Block Walls &bull; Structural Retaining Walls &bull; Dry-Stacked Stone Veneer &bull; Concrete Pumping &bull; Commercial Flatwork &bull; CSLB #1055499
      </p>
      <p class="footer-cities">
        Proudly serving Kingsburg &bull; Selma &bull; Fresno &bull; Clovis &bull; Reedley &bull; Sanger &bull; Madera &bull; Dinuba &bull; Visalia &bull; Hanford &bull; Central California
      </p>
      <div class="footer-copyright-row">
        <span>&copy; {new Date().getFullYear()} Ruiz Family Enterprises Inc. All Rights Reserved.</span>
        <span>Crafted for generations of endurance.</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--bg-dark-deep);
    color: var(--text-light-secondary);
    padding-top: clamp(3.5rem, 6vw, 5rem);
    padding-bottom: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem 2rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 680px) {
    .footer-top {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-top {
      grid-template-columns: 1.4fr 0.9fr 1fr 1fr;
    }
  }

  /* Brand Col */
  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .footer-logo-link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
  }

  .footer-logo-img {
    height: 48px;
    width: auto;
    object-fit: contain;
  }

  .footer-brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.1;
  }

  .brand-sub {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: #f59e0b;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .footer-mission-p {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-light-muted);
  }

  .footer-social-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .social-btn {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #cbd5e1;
    transition: all 0.2s ease;
  }

  .social-btn:hover {
    background: var(--ruiz-blue);
    color: #ffffff;
    border-color: var(--ruiz-blue);
    transform: translateY(-2px);
  }

  /* Nav & Links Columns */
  .col-heading {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }

  .footer-nav-list, .footer-links-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    font-size: 0.9rem;
  }

  .footer-nav-list a, .footer-links-list a {
    color: var(--text-light-secondary);
    transition: color 0.18s ease, transform 0.18s ease;
    display: inline-block;
  }

  .footer-nav-list a:hover, .footer-links-list a:hover {
    color: #60a5fa;
    transform: translateX(3px);
  }

  /* Contact Stack */
  .contact-items-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 0.9rem;
  }

  .c-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .c-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-light-muted);
    text-transform: uppercase;
  }

  .c-value {
    color: #ffffff;
    font-weight: 600;
  }

  .phone-link {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 700;
    color: #60a5fa;
  }

  .phone-link:hover {
    color: #93c5fd;
    text-decoration: underline;
  }

  .license-val {
    font-family: var(--font-mono);
    color: #f59e0b;
    font-size: 0.85rem;
  }

  /* Bottom Strip */
  .footer-bottom {
    padding-top: 2.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .footer-seo-line {
    font-size: 0.82rem;
    font-weight: 600;
    color: #cbd5e1;
    line-height: 1.6;
    max-width: 68ch;
    margin-inline: auto;
    text-wrap: balance;
  }

  .footer-cities {
    font-size: 0.78rem;
    color: var(--text-light-muted);
    line-height: 1.6;
    max-width: 68ch;
    margin-inline: auto;
    text-wrap: balance;
  }

  .footer-copyright-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.78rem;
    color: var(--text-light-muted);
  }
</style>
