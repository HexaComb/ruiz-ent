---
// Ruiz Family Enterprises - Site Header & Navigation
---

<!-- Top Credentials Strip -->
<div class="top-bar">
  <div class="container top-bar-inner">
    <div class="top-bar-license">
      <span class="license-cslb">License #1055499</span>
      <span class="top-bar-sep" aria-hidden="true">&bull;</span>
      <span class="license-classes-full">Masonry &amp; Concrete Contractor</span>
      <span class="license-classes-compact" aria-hidden="true">Masonry &amp; Concrete</span>
    </div>

    <div class="top-bar-contact">
      <span class="top-bar-area">Kingsburg, California</span>
      <span class="top-bar-sep area-sep" aria-hidden="true">&bull;</span>
      <a href="tel:+15592441922" class="top-bar-phone" aria-label="Call 559-244-1922">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01l-2.2 2.2z"/>
        </svg>
        <span>(559) 244-1922</span>
      </a>
    </div>
  </div>
</div>

<!-- Main Sticky Header -->
<header class="site-header" id="header" data-site-header>
  <div class="container header-inner">
    <!-- Brand Logo -->
    <a href="/" class="brand-link" aria-label="Ruiz Family Enterprises Home">
      <img
        src="/images/brand/ruiz-monogram-256.png"
        alt="Ruiz Family Enterprises Logo"
        class="brand-logo-img"
        width="256"
        height="256"
        loading="eager"
      />
      <div class="brand-text">
        <span class="brand-name">Ruiz Family Enterprises</span>
        <span class="brand-sub">Three Generations of Craftsmanship</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="main-nav" aria-label="Primary Navigation">
      <ul class="nav-list">
        <li><a href="#our-services" class="nav-link">Services</a></li>
        <li><a href="#engineering-public-works" class="nav-link">Engineering/Public Works</a></li>
        <li><a href="#our-work" class="nav-link">Our Work</a></li>
        <li><a href="#our-story" class="nav-link">Our Story</a></li>
        <li><a href="#reviews" class="nav-link">Reviews</a></li>
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <a href="tel:+15592441922" class="header-phone" aria-label="Call (559) 244-1922">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01l-2.2 2.2z"/>
        </svg>
        <span class="phone-number">(559) 244-1922</span>
      </a>

      <a href="#quote-builder" class="btn btn-primary btn-header-cta">
        <span>Discuss a Project</span>
        <span aria-hidden="true">&rarr;</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        type="button"
        class="mobile-toggle"
        id="mobileToggle"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobileDrawer"
      >
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-drawer" id="mobileDrawer" hidden aria-hidden="true">
    <div class="container mobile-drawer-inner">
      <nav class="mobile-nav" aria-label="Mobile Navigation">
        <ul class="mobile-nav-list">
          <li><a href="#our-services" class="mobile-nav-link">Services</a></li>
          <li><a href="#engineering-public-works" class="mobile-nav-link">Engineering/Public Works</a></li>
          <li><a href="#our-work" class="mobile-nav-link">Our Work &amp; Transformations</a></li>
          <li><a href="#our-story" class="mobile-nav-link">The Ruiz Story &amp; Legacy</a></li>
          <li><a href="#our-process" class="mobile-nav-link">Our 4-Step Process</a></li>
          <li><a href="#field-reels" class="mobile-nav-link">Field Reels &amp; Realness</a></li>
          <li><a href="#reviews" class="mobile-nav-link">Customer Reviews</a></li>
          <li><a href="#faq" class="mobile-nav-link">Frequently Asked Questions</a></li>
        </ul>
      </nav>

      <div class="mobile-drawer-cta">
        <a href="tel:+15592441922" class="mobile-call-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 011 1V20a1 1 0 01-1 1C10.61 21 3 13.39 3 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.46.57 3.58a1 1 0 01-.25 1.01l-2.2 2.2z"/>
          </svg>
          <span>Call: (559) 244-1922</span>
        </a>
        <a href="#quote-builder" class="btn btn-primary mobile-estimate-btn">
          <span>Discuss a Project</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  /* Top Credentials Strip - Understated Architectural Craft */
  .top-bar {
    background-color: #080d14;
    color: #94a3b8;
    font-size: 0.78rem;
    font-weight: 500;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    position: relative;
    z-index: 101;
    line-height: 1.4;
  }

  .top-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.5rem;
    gap: 1.5rem;
    min-width: 0;
  }

  .top-bar-license {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .license-cslb {
    color: #f1f5f9;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .license-classes-full {
    color: #94a3b8;
    font-weight: 400;
  }

  .license-classes-compact {
    display: none;
    color: #94a3b8;
    font-weight: 400;
  }

  .top-bar-sep {
    color: rgba(255, 255, 255, 0.2);
    font-size: 0.65rem;
  }

  .top-bar-contact {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .top-bar-area {
    color: #94a3b8;
    font-weight: 400;
  }

  .top-bar-phone {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #f1f5f9;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .top-bar-phone svg {
    color: #cbd5e1;
    transition: color 0.15s ease;
  }

  .top-bar-phone:hover {
    color: #ffffff;
  }

  .top-bar-phone:hover svg {
    color: #ffffff;
  }

  /* Sticky Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: #ffffff;
    border-bottom: 1px solid var(--border-light);
    transition: box-shadow 0.2s ease;
  }

  .site-header.is-scrolled {
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.08);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    gap: 1.25rem;
  }

  /* Brand Link */
  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-logo-img {
    height: 46px;
    width: auto;
    object-fit: contain;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.18rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-dark);
    line-height: 1.15;
  }

  .brand-sub {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ruiz-terracotta);
    letter-spacing: 0.01em;
  }

  /* Nav */
  .main-nav {
    display: none;
    flex-shrink: 0;
  }

  @media (min-width: 1120px) {
    .main-nav {
      display: flex;
      align-items: center;
    }
  }

  .nav-list {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: nowrap;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-list li {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .nav-link {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-dark-secondary);
    transition: color 0.15s ease;
    padding: 0.4rem 0.15rem;
    white-space: nowrap;
    display: inline-block;
    position: relative;
  }

  .nav-link:hover, .nav-link:focus-visible {
    color: var(--ruiz-blue);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    content: "";
    position: absolute;
    left: 0.15rem;
    right: 0.15rem;
    bottom: -2px;
    height: 2px;
    background-color: var(--ruiz-blue);
    border-radius: 2px;
  }

  /* Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    flex-shrink: 0;
  }

  .header-phone {
    display: none;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-dark);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  /* The always-visible top bar carries the phone; keep the main nav uncluttered. */

  .header-phone:hover {
    color: var(--ruiz-blue);
  }

  .btn-header-cta {
    padding: 0.6rem 1.15rem;
    font-size: 0.86rem;
    font-weight: 700;
    white-space: nowrap;
    border-radius: var(--radius-full);
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    width: 42px;
    height: 42px;
    padding: 9px;
    border-radius: var(--radius-sm);
    background: var(--bg-light);
    border: 1px solid var(--border-light);
    cursor: pointer;
  }

  @media (min-width: 1120px) {
    .mobile-toggle {
      display: none;
    }
  }

  .mobile-toggle .bar {
    width: 100%;
    height: 2.5px;
    background-color: var(--text-dark);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .mobile-toggle[aria-expanded="true"] .bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-toggle[aria-expanded="true"] .bar:nth-child(2) {
    opacity: 0;
  }

  .mobile-toggle[aria-expanded="true"] .bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Keep every navigation link reachable on shorter screens. */
  .mobile-drawer { max-height: calc(100dvh - var(--space-24)); overflow-y: auto; }

  /* Mobile Drawer */
  .mobile-drawer {
    background-color: #ffffff;
    border-bottom: 2px solid var(--border-light);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.12);
    padding-bottom: 1.5rem;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    padding-block: 0.75rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.85rem 0;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-dark);
    border-bottom: 1px solid var(--border-light);
  }

  .mobile-nav-link:hover {
    color: var(--ruiz-blue);
  }

  .mobile-drawer-cta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .mobile-call-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem;
    background: var(--bg-light);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--ruiz-blue);
  }

  .mobile-estimate-btn {
    width: 100%;
    padding: 0.95rem;
    font-size: 1rem;
  }

  @media (max-width: 1200px) {
    .license-classes-full {
      display: none;
    }
    .license-classes-compact {
      display: inline;
    }
  }

  @media (max-width: 960px) {
    .top-bar-area,
    .area-sep {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .license-classes-compact,
    .top-bar-license .top-bar-sep {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .top-bar-inner {
      padding-block: 0.4rem;
      gap: 0.75rem;
    }
    .brand-sub, .btn-header-cta { display: none; }
    .header-inner { height: 66px; gap: 0.65rem; }
    .brand-link { min-width: 0; flex-shrink: 1; gap: 0.5rem; }
    .brand-logo-img { height: 36px; flex-shrink: 0; }
    .brand-name { font-size: 1rem; max-width: 17ch; }
    .mobile-toggle { width: 44px; height: 44px; }
  }
</style>

<script>
  const toggle = document.getElementById('mobileToggle');
  const drawer = document.getElementById('mobileDrawer');
  const navLinks = drawer?.querySelectorAll('a');

  function setDrawer(open: boolean) {
    if (!toggle || !drawer) return;
    toggle.setAttribute('aria-expanded', String(open));
    drawer.hidden = !open;
    drawer.setAttribute('aria-hidden', String(!open));
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    setDrawer(!isOpen);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setDrawer(false);
      toggle.focus();
    }
  });

  window.matchMedia('(min-width: 1120px)').addEventListener('change', (event) => {
    if (event.matches) setDrawer(false);
  });

  navLinks?.forEach(link => {
    link.addEventListener('click', () => setDrawer(false));
  });

  const header = document.querySelector('[data-site-header]');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      header?.classList.add('is-scrolled');
    } else {
      header?.classList.remove('is-scrolled');
    }
  }, { passive: true });
</script>
